class ExcepcionIsbnDuplicado : public runtime_error
{
public:
    ExcepcionIsbnDuplicado(string mensaje) : runtime_error(mensaje)
    {
    }
};

class ExcepcionInventarioLleno : public runtime_error
{
public:
    ExcepcionInventarioLleno(string mensaje) : runtime_error(mensaje)
    {
    }
};

class ExcepcionDatoInvalido : public runtime_error
{
public:
    ExcepcionDatoInvalido(string mensaje) : runtime_error(mensaje)
    {
    }
};



// CLASE Comic

class Comic
{
private:
    string titulo;
    string editorial;
    int numeroEdicion;
    string isbn;
    double precio;
    int anioPublicacion;
    string estadoConservacion;
    bool esEdicionLimitada;
    string genero;

public:
    // Constructor por defecto
    Comic()
    {
        this->titulo = "";
        this->editorial = "";
        this->numeroEdicion = 0;
        this->isbn = "";
        this->precio = 0.0;
        this->anioPublicacion = 0;
        this->estadoConservacion = "";
        this->esEdicionLimitada = false;
        this->genero = "";
    }

    // Constructor con parametros
    Comic(string titulo, string editorial, int numeroEdicion, string isbn,
        double precio, int anioPublicacion, string estadoConservacion,
        bool esEdicionLimitada, string genero)
    {
        this->titulo = titulo;
        this->editorial = editorial;
        this->numeroEdicion = numeroEdicion;
        this->isbn = isbn;
        this->precio = precio;
        this->anioPublicacion = anioPublicacion;
        this->estadoConservacion = estadoConservacion;
        this->esEdicionLimitada = esEdicionLimitada;
        this->genero = genero;
    }

    //  GETTERS 
    string getTitulo()
    {
        return this->titulo;
    }

    string getEditorial()
    {
        return this->editorial;
    }

    int getNumeroEdicion()
    {
        return this->numeroEdicion;
    }

    string getIsbn()
    {
        return this->isbn;
    }

    double getPrecio()
    {
        return this->precio;
    }

    int getAnioPublicacion()
    {
        return this->anioPublicacion;
    }

    string getEstadoConservacion()
    {
        return this->estadoConservacion;
    }

    bool getEsEdicionLimitada()
    {
        return this->esEdicionLimitada;
    }

    string getGenero()
    {
        return this->genero;
    }

    //  SETTERS 
    void setTitulo(string titulo)
    {
        this->titulo = titulo;
    }

    void setEditorial(string editorial)
    {
        this->editorial = editorial;
    }

    void setNumeroEdicion(int numeroEdicion)
    {
        this->numeroEdicion = numeroEdicion;
    }

    void setIsbn(string isbn)
    {
        this->isbn = isbn;
    }

    void setPrecio(double precio)
    {
        if (precio < 0)
        {
            throw ExcepcionDatoInvalido("El precio no puede ser negativo.");
        }
        this->precio = precio;
    }

    void setAnioPublicacion(int anioPublicacion)
    {
        if (anioPublicacion < 1900 || anioPublicacion > 2100)
        {
            throw ExcepcionDatoInvalido("El anio de publicacion no es valido.");
        }
        this->anioPublicacion = anioPublicacion;
    }

    void setEstadoConservacion(string estadoConservacion)
    {
        this->estadoConservacion = estadoConservacion;
    }

    void setEsEdicionLimitada(bool esEdicionLimitada)
    {
        this->esEdicionLimitada = esEdicionLimitada;
    }

    void setGenero(string genero)
    {
        this->genero = genero;
    }

    void mostrarInformacion()
    {
        cout << "------------------------------------------------------" << endl;
        cout << "Titulo            : " << this->titulo << endl;
        cout << "Editorial         : " << this->editorial << endl;
        cout << "No. de edicion    : " << this->numeroEdicion << endl;
        cout << "ISBN              : " << this->isbn << endl;
        cout << "Precio            : Q" << this->precio << endl;
        cout << "Anio publicacion  : " << this->anioPublicacion << endl;
        cout << "Estado            : " << this->estadoConservacion << endl;
        cout << "Edicion limitada  : " << (this->esEdicionLimitada ? "Si" : "No") << endl;
        cout << "Genero            : " << this->genero << endl;
        cout << "------------------------------------------------------" << endl;
    }
};



// CONSTANTES GLOBALES
const int TAMANO_INVENTARIO = 5;



// PROTOTIPOS DE FUNCIONES
int mostrarMenu();
void registrarComic(Comic* inventario[], int tamano);
void mostrarComics(Comic* inventario[], int tamano);
void buscarComic(Comic* inventario[], int tamano);
void eliminarComic(Comic* inventario[], int tamano);
bool existeIsbn(Comic* inventario[], int tamano, string isbn);
void liberarInventario(Comic* inventario[], int tamano);
int leerEntero(string mensaje);
double leerDouble(string mensaje);


// FUNCION PRINCIPAL
int main()
{
    Comic* inventario[TAMANO_INVENTARIO];
    for (int i = 0; i < TAMANO_INVENTARIO; i++)
    {
        inventario[i] = nullptr;
    }

    int opcion = 0;

    do
    {
        opcion = mostrarMenu();

        switch (opcion)
        {
        case 1:
            registrarComic(inventario, TAMANO_INVENTARIO);
            break;
        case 2:
            mostrarComics(inventario, TAMANO_INVENTARIO);
            break;
        case 3:
            buscarComic(inventario, TAMANO_INVENTARIO);
            break;
        case 4:
            eliminarComic(inventario, TAMANO_INVENTARIO);
            break;
        case 5:
            cout << "\nSaliendo del sistema... Hasta luego!\n" << endl;
            break;
        default:
            cout << "\nOpcion invalida, intente de nuevo.\n" << endl;
            break;
        }

    } while (opcion != 5);

    // Liberar memoria de los comics que quedaron pendientes
    liberarInventario(inventario, TAMANO_INVENTARIO);

    system("pause");
    return 0;
}



// IMPLEMENTACION DE FUNCIONES

int mostrarMenu()
{
    int opcion;
    cout << "========================================" << endl;
    cout << "   PROGRAMACION AVANZADA COMIC BOOK STORE" << endl;
