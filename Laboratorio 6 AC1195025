int leerEntero(string mensaje)
{
    int valor;
    cout << mensaje;
    while (!(cin >> valor))
    {
        cin.clear();
        cin.ignore(10000, '\n');
        cout << "Entrada invalida. Ingrese un numero entero: ";
    }
    cin.ignore();
    return valor;
}

double leerDouble(string mensaje)
{
    double valor;
    cout << mensaje;
    while (!(cin >> valor))
    {
        cin.clear();
        cin.ignore(10000, '\n');
        cout << "Entrada invalida. Ingrese un numero: ";
    }
    cin.ignore();
    return valor;
}

bool existeIsbn(Comic* inventario[], int tamano, string isbn)
{
    for (int i = 0; i < tamano; i++)
    {
        if (inventario[i] != nullptr && inventario[i]->getIsbn() == isbn)
        {
            return true;
        }
    }
    return false;
}


void registrarComic(Comic* inventario[], int tamano)
{
   
    int posicionLibre = -1;
    for (int i = 0; i < tamano; i++)
    {
        if (inventario[i] == nullptr)
        {
            posicionLibre = i;
            break;
        }
    }

    try
    {
        if (posicionLibre == -1)
        {
            throw ExcepcionInventarioLleno("No hay espacio disponible en el inventario. Elimine un comic antes de registrar otro.");
        }

        cout << "\n--- Registrar nuevo comic ---" << endl;

        string titulo, editorial, isbn, estadoConservacion, genero;
        int numeroEdicion, anioPublicacion;
        double precio;
        char respuestaEdicionLimitada;
        bool esEdicionLimitada;

        cout << "Titulo: ";
        getline(cin, titulo);

        cout << "Editorial (Marvel, DC, Image, etc.): ";
        getline(cin, editorial);

        numeroEdicion = leerEntero("Numero de edicion (issue #): ");

        cout << "ISBN o codigo de barras: ";
        getline(cin, isbn);

        if (existeIsbn(inventario, tamano, isbn))
        {
            throw ExcepcionIsbnDuplicado("Ya existe un comic registrado con el ISBN: " + isbn);
        }

        precio = leerDouble("Precio: Q");
        anioPublicacion = leerEntero("Anio de publicacion: ");

        cout << "Estado de conservacion (Nuevo / Usado-Bueno / Usado-Regular): ";
        getline(cin, estadoConservacion);

        cout << "Es edicion limitada? (s/n): ";
        cin >> respuestaEdicionLimitada;
        cin.ignore();
        esEdicionLimitada = (respuestaEdicionLimitada == 's' || respuestaEdicionLimitada == 'S');

        cout << "Genero/Categoria (superheroes, terror, ciencia ficcion, etc.): ";
        getline(cin, genero);

        inventario[posicionLibre] = new Comic(titulo, editorial, numeroEdicion, isbn,
            precio, anioPublicacion, estadoConservacion,
            esEdicionLimitada, genero);

        cout << "\nComic registrado exitosamente en la posicion " << (posicionLibre + 1) << ".\n" << endl;
    }
    catch (ExcepcionInventarioLleno& e)
    {
        cout << "\n[Error] " << e.what() << "\n" << endl;
    }
    catch (ExcepcionIsbnDuplicado& e)
    {
        cout << "\n[Error] " << e.what() << "\n" << endl;
    }
    catch (ExcepcionDatoInvalido& e)
    {
        cout << "\n[Error] " << e.what() << "\n" << endl;
    }
}

void mostrarComics(Comic* inventario[], int tamano)
{
    cout << "\n=== INVENTARIO DE COMICS ===" << endl;

    bool hayComics = false;

    for (int i = 0; i < tamano; i++)
    {
        if (inventario[i] != nullptr)
        {
            cout << "\nPosicion " << (i + 1) << ":" << endl;
            inventario[i]->mostrarInformacion();
            hayComics = true;
        }
    }

    if (!hayComics)
    {
        cout << "\nEl inventario esta vacio, no hay comics registrados.\n" << endl;
    }
    else
    {
        cout << endl;
    }
}


void buscarComic(Comic* inventario[], int tamano)
{
    int criterio;
    string valorBusqueda;
    bool encontrado = false;

    cout << "\n--- Buscar comic ---" << endl;
    cout << "Buscar por:" << endl;
    cout << "1. Nombre (titulo)" << endl;
    cout << "2. ISBN" << endl;
    cout << "3. Editorial" << endl;
    cout << "4. Numero de edicion" << endl;
    criterio = leerEntero("Seleccione una opcion: ");

    if (criterio < 1 || criterio > 4)
    {
        cout << "\nOpcion de busqueda invalida.\n" << endl;
        return;
    }

    if (criterio == 4)
    {
        int numeroBuscado = leerEntero("Ingrese el numero de edicion a buscar: ");

        for (int i = 0; i < tamano; i++)
        {
            if (inventario[i] != nullptr && inventario[i]->getNumeroEdicion() == numeroBuscado)
            {
                cout << "\nComic encontrado en la posicion " << (i + 1) << ":" << endl;
                inventario[i]->mostrarInformacion();
                encontrado = true;
            }
        }
    }
    else
    {
        cout << "Ingrese el valor a buscar: ";
        getline(cin, valorBusqueda);

        for (int i = 0; i < tamano; i++)
        {
            if (inventario[i] == nullptr)
            {
                continue;
            }

            bool coincide = false;

            if (criterio == 1 && inventario[i]->getTitulo() == valorBusqueda)
            {
                coincide = true;
            }
            else if (criterio == 2 && inventario[i]->getIsbn() == valorBusqueda)
            {
                coincide = true;
            }
            else if (criterio == 3 && inventario[i]->getEditorial() == valorBusqueda)
            {
                coincide = true;
            }

            if (coincide)
            {
                cout << "\nComic encontrado en la posicion " << (i + 1) << ":" << endl;
                inventario[i]->mostrarInformacion();
                encontrado = true;
            }
        }
    }

    if (!encontrado)
    {
        cout << "\nNo se encontro ningun comic que coincida con ese criterio.\n" << endl;
    }
    else
    {
        cout << endl;
    }
}

void eliminarComic(Comic* inventario[], int tamano)
{
    int criterio;
    string valorBusqueda;
    bool eliminadoAlgo = false;

    cout << "\n--- Eliminar comic ---" << endl;
    cout << "Eliminar por:" << endl;
    cout << "1. Nombre (titulo)" << endl;
    cout << "2. ISBN" << endl;
    cout << "3. Editorial" << endl;
    cout << "4. Numero de edicion" << endl;
    criterio = leerEntero("Seleccione una opcion: ");

    if (criterio < 1 || criterio > 4)
    {
        cout << "\nOpcion invalida.\n" << endl;
        return;
    }

    int numeroBuscado = 0;
    if (criterio == 4)
    {
        numeroBuscado = leerEntero("Ingrese el numero de edicion a eliminar: ");
    }
    else
    {
        cout << "Ingrese el valor a buscar: ";
        getline(cin, valorBusqueda);
    }

    for (int i = 0; i < tamano; i++)
    {
        if (inventario[i] == nullptr)
        {
            continue;
        }

        bool coincide = false;

        if (criterio == 1 && inventario[i]->getTitulo() == valorBusqueda)
        {
            coincide = true;
        }
        else if (criterio == 2 && inventario[i]->getIsbn() == valorBusqueda)
        {
            coincide = true;
        }
        else if (criterio == 3 && inventario[i]->getEditorial() == valorBusqueda)
        {
            coincide = true;
        }
        else if (criterio == 4 && inventario[i]->getNumeroEdicion() == numeroBuscado)
        {
            coincide = true;
        }

        if (coincide)
        {
            cout << "\nEliminando comic en la posicion " << (i + 1) << ": "
                << inventario[i]->getTitulo() << endl;

            delete inventario[i];
            inventario[i] = nullptr;
            eliminadoAlgo = true;
        }
    }

    if (!eliminadoAlgo)
    {
        cout << "\nNo se encontro ningun comic que coincida con ese criterio.\n" << endl;
    }
    else
    {
        cout << "\nEliminacion completada.\n" << endl;
    }
}


void liberarInventario(Comic* inventario[], int tamano)
{
    for (int i = 0; i < tamano; i++)
    {
        if (inventario[i] != nullptr)
        {
            delete inventario[i];
            inventario[i] = nullptr;
        }
    }
}
