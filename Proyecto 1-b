// ENUM DE POSICIONES


enum class Posicion
{
    PORTERO,
    DEFENSA,
    MEDIOCAMPISTA,
    DELANTERO
};


// CLASE BASE ABSTRACTA: Jugador


class Jugador
{
protected:
    int id;
    string nombre;
    int valorMercado;
    string clubActual;

public:
    Jugador(int id, const string& nombre, int valorMercado, const string& clubActual)
    {
        this->id = id;
        this->nombre = nombre;
        this->valorMercado = valorMercado;
        this->clubActual = clubActual;
    }

    virtual ~Jugador()
    {
    }

    int getId() const
    {
        return this->id;
    }

    string getNombre() const
    {
        return this->nombre;
    }

    int getValorMercado() const
    {
        return this->valorMercado;
    }

    string getClubActual() const
    {
        return this->clubActual;
    }

    void setValorMercado(int valorMercado)
    {
        if (valorMercado < 5)
        {
            valorMercado = 5;
        }

        this->valorMercado = valorMercado;
    }

    void setClubActual(const string& clubActual)
    {
        this->clubActual = clubActual;
    }

    virtual string mostrarDescripcion() const = 0;
    virtual Posicion getPosicion() const = 0;
};


