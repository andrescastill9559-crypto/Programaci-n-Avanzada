    void realizarOferta(int idJugador, int monto)
    {
        int idClubDueno = -1;
        Jugador* jugador = this->buscarJugadorPorId(idJugador, &idClubDueno);

        if (jugador == nullptr)
        {
            throw JugadorNoEncontradoException("No existe un jugador con ese identificador.");
        }

        if (idClubDueno == this->idClubUsuario)
        {
            throw EntradaInvalidaException("No puedes ofertar por un jugador de tu propio club.");
        }

        Oferta nuevaOferta;
        nuevaOferta.id = this->siguienteIdOferta++;
        nuevaOferta.jugador = jugador;
        nuevaOferta.idClubComprador = this->idClubUsuario;
        nuevaOferta.idClubVendedor = idClubDueno;
        nuevaOferta.monto = monto;
        nuevaOferta.estado = "pendiente";

        this->ofertas.push_back(nuevaOferta);

        cout << "Oferta registrada. Se resolvera al avanzar de dia.\n";
    }

    void revisarOfertasRecibidas()
    {
        int indice = this->indiceClubUsuario();
        Club& miClub = this->clubes[indice];

        if (miClub.jugadores.empty())
        {
            cout << "No tienes jugadores para recibir ofertas.\n";
            return;
        }

        int posicionAleatoria = rand() % static_cast<int>(miClub.jugadores.size());
        Jugador* jugadorOfertado = miClub.jugadores[posicionAleatoria];

        int idClubComprador;

        do
        {
            idClubComprador = this->clubes[rand() % this->clubes.size()].id;
        } while (idClubComprador == this->idClubUsuario);

        int porcentaje = 90 + (rand() % (130 - 90 + 1));
        int monto = (jugadorOfertado->getValorMercado() * porcentaje) / 100;

        cout << "\nOferta recibida por " << jugadorOfertado->getNombre()
            << " (valor actual " << jugadorOfertado->getValorMercado() << "M): " << monto << "M EUR.\n";

        int opcion = leerEnteroValidado("1. Aceptar   2. Rechazar: ", 1, 2);

        if (opcion == 1)
        {
            if (this->contarJugadoresPorPosicion(miClub, jugadorOfertado->getPosicion()) <= 1)
            {
                cout << "No puedes aceptar: te quedarias sin jugadores en esa posicion.\n";
                this->ofertasRechazadas++;
                return;
            }

            this->moverJugadorEntreClubes(jugadorOfertado, this->idClubUsuario, idClubComprador, monto, this->diaActual);
            this->totalRecibido += monto;
            this->jugadoresVendidos.push_back(jugadorOfertado->getNombre());
            this->ofertasAceptadas++;
            cout << "Oferta aceptada. Presupuesto actualizado.\n";
        }
        else
        {
            this->ofertasRechazadas++;
            cout << "Oferta rechazada.\n";
        }
    }

    void verHistorial() const
    {
        if (this->historial.empty())
        {
            cout << "Aun no hay transferencias registradas.\n";
            return;
        }

        cout << "\n---- Historial de transferencias ----\n";

        for (size_t i = 0; i < this->historial.size(); i++)
        {
            const Transferencia& t = this->historial[i];
            cout << "Dia " << t.dia << ": " << t.jugador->getNombre() << " | "
                << t.origen << " -> " << t.destino << " | " << t.montoPagado << "M EUR\n";
        }
    }

    void avanzarDia()
    {
        for (size_t i = 0; i < this->ofertas.size(); i++)
        {
            Oferta& oferta = this->ofertas[i];

            if (oferta.estado != "pendiente")
            {
                continue;
            }

            int valorActual = oferta.jugador->getValorMercado();
            int minimoAceptable = (valorActual * 110) / 100;

            int indiceClubVendedor = this->indiceClubPorId(oferta.idClubVendedor);
            int indiceClubComprador = this->indiceClubUsuario();

            bool tienePresupuesto = this->clubes[indiceClubComprador].presupuesto >= oferta.monto;
            bool clubQuedariaSinPosicion =
                (indiceClubVendedor >= 0)
                && (this->contarJugadoresPorPosicion(this->clubes[indiceClubVendedor], oferta.jugador->getPosicion()) <= 1);

            if (oferta.monto < minimoAceptable)
            {
                oferta.estado = "rechazada";
                this->ofertasRechazadas++;
                cout << "Tu oferta por " << oferta.jugador->getNombre() << " fue rechazada (monto insuficiente).\n";
            }
            else if (!tienePresupuesto)
            {
                oferta.estado = "rechazada";
                this->ofertasRechazadas++;
                cout << "Tu oferta por " << oferta.jugador->getNombre() << " no se pudo completar: presupuesto insuficiente.\n";
            }
            else if (clubQuedariaSinPosicion)
            {
                oferta.estado = "rechazada";
                this->ofertasRechazadas++;
                cout << "Tu oferta por " << oferta.jugador->getNombre() << " fue rechazada: el club vendedor se quedaria sin jugadores en esa posicion.\n";
            }
            else
            {
                oferta.estado = "aceptada";
                this->ofertasAceptadas++;
                this->totalGastado += oferta.monto;
                this->jugadoresComprados.push_back(oferta.jugador->getNombre());

                this->moverJugadorEntreClubes(oferta.jugador, oferta.idClubVendedor, oferta.idClubComprador, oferta.monto, this->diaActual);

                cout << "Tu oferta por " << oferta.jugador->getNombre() << " fue aceptada.\n";
            }
        }

        for (size_t i = 0; i < this->todosLosJugadores.size(); i++)
        {
            Jugador* jugador = this->todosLosJugadores[i];
            int variacion = (rand() % 11) - 5; // -5 a +5
            int nuevoValor = jugador->getValorMercado() + (jugador->getValorMercado() * variacion) / 100;

            jugador->setValorMercado(nuevoValor);
        }

        this->diaActual++;
        cout << "\n>> Avanzaste al dia " << this->diaActual << " de " << this->diasSimulacion << ".\n";
    }

    void generarReporteFinal() const
    {
        int indice = this->indiceClubUsuario();
        const Club& club = this->clubes[indice];

        cout << "\n==================== REPORTE FINAL ====================\n";

        cout << "\nPlantilla inicial:\n";
        for (size_t i = 0; i < this->plantillaInicialUsuario.size(); i++)
        {
            cout << "  - " << this->plantillaInicialUsuario[i] << "\n";
        }

        cout << "\nPlantilla final:\n";
        for (size_t i = 0; i < club.jugadores.size(); i++)
        {
            cout << "  - " << club.jugadores[i]->getNombre() << "\n";
        }

        cout << "\nPresupuesto inicial: " << this->presupuestoInicialUsuario << "M EUR\n";
        cout << "Presupuesto disponible: " << club.presupuesto << "M EUR\n";
        cout << "Total gastado en compras: " << this->totalGastado << "M EUR\n";
        cout << "Total recibido por ventas: " << this->totalRecibido << "M EUR\n";

        cout << "\nJugadores comprados: " << this->jugadoresComprados.size() << "\n";
        for (size_t i = 0; i < this->jugadoresComprados.size(); i++)
        {
            cout << "  - " << this->jugadoresComprados[i] << "\n";
        }

        cout << "\nJugadores vendidos: " << this->jugadoresVendidos.size() << "\n";
        for (size_t i = 0; i < this->jugadoresVendidos.size(); i++)
        {
            cout << "  - " << this->jugadoresVendidos[i] << "\n";
        }

        cout << "\nOfertas aceptadas: " << this->ofertasAceptadas << "\n";
        cout << "Ofertas rechazadas: " << this->ofertasRechazadas << "\n";

        this->verHistorial();

        cout << "\n=========================================================\n";
    }

    bool simulacionTerminada() const
    {
        return this->diaActual >= this->diasSimulacion;
    }

    int getIdClubUsuario() const
    {
        return this->idClubUsuario;
    }
};


// MAIN


int main()
{
    SimuladorMercado simulador;

    try
    {
        simulador.iniciarPartida();

        while (!simulador.simulacionTerminada())
        {
            simulador.mostrarMenu();

            try
            {
                int opcion = leerEnteroValidado("Elige una opcion: ", 1, 6);

                switch (opcion)
                {
                case 1:
                    simulador.verClub(simulador.getIdClubUsuario());
                    break;
                case 2:
                    simulador.explorarJugadores();
                    break;
                case 3:
                {
                    int idJugador = leerEnteroValidado("Ingresa el identificador del jugador que quieres ofertar: ", 1, 999);
                    int monto = leerEnteroValidado("Ingresa el monto que deseas ofrecer (millones EUR): ", 1, 1000);
                    simulador.realizarOferta(idJugador, monto);
                    break;
                }
                case 4:
                    simulador.revisarOfertasRecibidas();
                    break;
                case 5:
                    simulador.verHistorial();
                    break;
                case 6:
                    simulador.avanzarDia();
                    break;
                default:
                    cout << "Opcion no valida, intenta de nuevo.\n";
                    break;
                }
            }
            catch (const ExcepcionMercato& error)
            {
                cout << "Error: " << error.what() << "\n";
            }
        }

        simulador.generarReporteFinal();
    }
    catch (const exception& errorFatal)
    {
        cout << "Error inesperado: " << errorFatal.what() << "\n";
    }

    return 0;
}
