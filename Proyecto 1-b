// STRUCTS AUXILIARES (coinciden con el diagrama de clases)


struct Club
{
    int id;
    string nombre;
    int presupuesto;
    vector<Jugador*> jugadores;
};

struct Oferta
{
    int id;
    Jugador* jugador;
    int idClubComprador;
    int idClubVendedor;
    int monto;
    string estado; // "pendiente", "aceptada", "rechazada"
};

struct Transferencia
{
    int dia;
    Jugador* jugador;
    string origen;
    string destino;
    int montoPagado;
};


// VALIDACION DE ENTRADA (reutilizable, no rompe el programa)


int leerEnteroValidado(const string& mensaje, int minimo, int maximo)
{
    int valor;

    while (true)
    {
        cout << mensaje;
        cin >> valor;

        if (cin.fail())
        {
            cin.clear();
            cin.ignore(10000, '\n');
            cout << "Entrada invalida, debes ingresar un numero.\n";
            continue;
        }

        if (valor < minimo || valor > maximo)
        {
            cout << "El valor debe estar entre " << minimo << " y " << maximo << ".\n";
            continue;
        }

        return valor;
    }
}


// CLASE SimuladorMercado

class SimuladorMercado
{
private:
    vector<Club> clubes;
    vector<Jugador*> todosLosJugadores;
    vector<Oferta> ofertas;
    vector<Transferencia> historial;

    int idClubUsuario;
    int diaActual;
    int diasSimulacion;
    int siguienteIdOferta;

    int presupuestoInicialUsuario;
    vector<string> plantillaInicialUsuario;

    int totalGastado;
    int totalRecibido;
    int ofertasAceptadas;
    int ofertasRechazadas;
    vector<string> jugadoresComprados;
    vector<string> jugadoresVendidos;


    // Helpers privados


    int indiceClubUsuario() const
    {
        for (size_t i = 0; i < this->clubes.size(); i++)
        {
            if (this->clubes[i].id == this->idClubUsuario)
            {
                return static_cast<int>(i);
            }
        }

        throw ExcepcionMercato("No se encontro el club del usuario.");
    }

    int indiceClubPorId(int idClub) const
    {
        for (size_t i = 0; i < this->clubes.size(); i++)
        {
            if (this->clubes[i].id == idClub)
            {
                return static_cast<int>(i);
            }
        }

        return -1;
    }

    int valorAleatorioPorPosicion(Posicion posicion) const
    {
        switch (posicion)
        {
        case Posicion::PORTERO:
            return 20 + (rand() % (70 - 20 + 1));
        case Posicion::DEFENSA:
            return 25 + (rand() % (90 - 25 + 1));
        case Posicion::MEDIOCAMPISTA:
            return 30 + (rand() % (110 - 30 + 1));
        case Posicion::DELANTERO:
            return 35 + (rand() % (140 - 35 + 1));
        default:
            return 20;
        }
    }

    Jugador* crearJugadorPorPosicion(int id, const string& nombre, Posicion posicion, const string& club)
    {
        int valor = this->valorAleatorioPorPosicion(posicion);

        switch (posicion)
        {
        case Posicion::PORTERO:
            return new Portero(id, nombre, valor, club);
        case Posicion::DEFENSA:
            return new Defensa(id, nombre, valor, club);
        case Posicion::MEDIOCAMPISTA:
            return new Mediocampista(id, nombre, valor, club);
        case Posicion::DELANTERO:
            return new Delantero(id, nombre, valor, club);
        default:
            throw ExcepcionMercato("Posicion desconocida al crear jugador.");
        }
    }

    Jugador* buscarJugadorPorId(int idJugador, int* idClubDueno = nullptr) const
    {
        for (size_t c = 0; c < this->clubes.size(); c++)
        {
            for (size_t j = 0; j < this->clubes[c].jugadores.size(); j++)
            {
                if (this->clubes[c].jugadores[j]->getId() == idJugador)
                {
                    if (idClubDueno != nullptr)
                    {
                        *idClubDueno = this->clubes[c].id;
                    }

                    return this->clubes[c].jugadores[j];
                }
            }
        }

        return nullptr;
    }

    int contarJugadoresPorPosicion(const Club& club, Posicion posicion) const
    {
        int contador = 0;

        for (size_t i = 0; i < club.jugadores.size(); i++)
        {
            if (club.jugadores[i]->getPosicion() == posicion)
            {
                contador++;
            }
        }

        return contador;
    }

    void moverJugadorEntreClubes(Jugador* jugador, int idClubOrigen, int idClubDestino, int monto, int dia)
    {
        Club* clubOrigen = nullptr;
        Club* clubDestino = nullptr;

        for (size_t i = 0; i < this->clubes.size(); i++)
        {
            if (this->clubes[i].id == idClubOrigen)
            {
                clubOrigen = &this->clubes[i];
            }

            if (this->clubes[i].id == idClubDestino)
            {
                clubDestino = &this->clubes[i];
            }
        }

        if (clubOrigen == nullptr || clubDestino == nullptr)
        {
            throw ExcepcionMercato("Club origen o destino no encontrado al transferir.");
        }

        for (size_t i = 0; i < clubOrigen->jugadores.size(); i++)
        {
            if (clubOrigen->jugadores[i]->getId() == jugador->getId())
            {
                clubOrigen->jugadores.erase(clubOrigen->jugadores.begin() + i);
                break;
            }
        }

        clubOrigen->presupuesto += monto;
        clubDestino->presupuesto -= monto;

        jugador->setClubActual(clubDestino->nombre);
        clubDestino->jugadores.push_back(jugador);

        Transferencia transferencia;
        transferencia.dia = dia;
        transferencia.jugador = jugador;
        transferencia.origen = clubOrigen->nombre;
        transferencia.destino = clubDestino->nombre;
        transferencia.montoPagado = monto;
        this->historial.push_back(transferencia);
    }

    void solicitarClubUsuario()
    {
        cout << "\n---- Elige el club que vas a administrar ----\n";

        for (size_t i = 0; i < this->clubes.size(); i++)
        {
            cout << this->clubes[i].id << ". " << this->clubes[i].nombre << "\n";
        }

        int eleccion = leerEnteroValidado("Ingresa el numero del club: ", 1, static_cast<int>(this->clubes.size()));

        this->idClubUsuario = eleccion;

        int indice = this->indiceClubUsuario();
        this->presupuestoInicialUsuario = this->clubes[indice].presupuesto;

        for (size_t i = 0; i < this->clubes[indice].jugadores.size(); i++)
        {
            this->plantillaInicialUsuario.push_back(this->clubes[indice].jugadores[i]->getNombre());
        }
    }

    void solicitarDiasSimulacion()
    {
        this->diasSimulacion = leerEnteroValidado("Ingresa la cantidad de dias de simulacion (5 a 15): ", 5, 15);
    }

    void mostrarConfiguracionInicial() const
    {
        cout << "\n==================== CONFIGURACION INICIAL ====================\n";

        for (size_t i = 0; i < this->clubes.size(); i++)
        {
            const Club& club = this->clubes[i];
            cout << "\nClub: " << club.nombre << " (Presupuesto: " << club.presupuesto << "M EUR)";

            if (club.id == this->idClubUsuario)
            {
                cout << "  <-- tu club";
            }

            cout << "\n";

            for (size_t j = 0; j < club.jugadores.size(); j++)
            {
                cout << "  [" << club.jugadores[j]->getId() << "] "
                    << club.jugadores[j]->mostrarDescripcion() << "\n";
            }
        }

        cout << "\nDias de simulacion: " << this->diasSimulacion << "\n";
        cout << "=================================================================\n";
    }

public:
    SimuladorMercado()
    {
        this->idClubUsuario = -1;
        this->diaActual = 0;
        this->diasSimulacion = 0;
        this->siguienteIdOferta = 1;
        this->presupuestoInicialUsuario = 0;
        this->totalGastado = 0;
        this->totalRecibido = 0;
        this->ofertasAceptadas = 0;
        this->ofertasRechazadas = 0;
        srand(static_cast<unsigned int>(time(nullptr)));
    }

    ~SimuladorMercado()
    {
        this->liberarMemoria();
    }

    void liberarMemoria()
    {
        for (size_t i = 0; i < this->todosLosJugadores.size(); i++)
        {
            delete this->todosLosJugadores[i];
        }

        this->todosLosJugadores.clear();
    }


    // crearJugadores(): crea los 6 clubes con sus 5 jugadores reales


    void crearJugadores()
    {
        string nombresClubes[6] = {
            "Real Madrid", "FC Barcelona", "Manchester City",
            "Liverpool", "Bayern Munich", "Paris Saint-Germain"
        };

        // Jugadores reales, temporada 2025-26. Orden por club:
        // Portero, Defensa, Mediocampista, Delantero, Quinto (libre)
        string nombresJugadores[6][5] = {
            {"Thibaut Courtois", "Eder Militao", "Jude Bellingham", "Kylian Mbappe", "Federico Valverde"},
            {"Joan Garcia", "Pau Cubarsi", "Pedri", "Robert Lewandowski", "Lamine Yamal"},
            {"Gianluigi Donnarumma", "Ruben Dias", "Rodri", "Erling Haaland", "Phil Foden"},
            {"Alisson Becker", "Virgil van Dijk", "Dominik Szoboszlai", "Mohamed Salah", "Florian Wirtz"},
            {"Manuel Neuer", "Jonathan Tah", "Michael Olise", "Harry Kane", "Luis Diaz"},
            {"Lucas Chevalier", "Marquinhos", "Vitinha", "Ousmane Dembele", "Achraf Hakimi"}
        };

        Posicion posicionesBase[5] = {
            Posicion::PORTERO, Posicion::DEFENSA, Posicion::MEDIOCAMPISTA,
            Posicion::DELANTERO, Posicion::MEDIOCAMPISTA
        };

        int idJugadorGlobal = 1;

        for (int c = 0; c < 6; c++)
        {
            Club nuevoClub;
            nuevoClub.id = c + 1;
            nuevoClub.nombre = nombresClubes[c];
            nuevoClub.presupuesto = 100 + (rand() % (200 - 100 + 1));

            for (int j = 0; j < 5; j++)
            {
                Jugador* nuevoJugador = this->crearJugadorPorPosicion(
                    idJugadorGlobal, nombresJugadores[c][j], posicionesBase[j], nuevoClub.nombre);

                nuevoClub.jugadores.push_back(nuevoJugador);
                this->todosLosJugadores.push_back(nuevoJugador);
                idJugadorGlobal++;
            }

            this->clubes.push_back(nuevoClub);
        }
    }


    // iniciarPartida(): orquesta toda la configuracion inicial


    void iniciarPartida()
    {
        this->crearJugadores();
        this->solicitarClubUsuario();
        this->solicitarDiasSimulacion();
        this->mostrarConfiguracionInicial();
    }


