// CLASE ABSTRACTA: Empleado


class Empleado
{
protected:
    string nombre;
    int id;
    double salario;

public:
    Empleado(string nombre, int id, double salario)
    {
        this->nombre = nombre;
        this->id = id;

        if (salario < 0)
        {
            throw EmpleadoException("El salario no puede ser negativo.");
        }

        this->salario = salario;
    }

    virtual ~Empleado()
    {
    }

    virtual void mostrarInfo() const = 0;

    virtual string getTipo() const = 0;

    string getNombre() const
    {
        return this->nombre;
    }

    void setNombre(string nombre)
    {
        this->nombre = nombre;
    }

    int getId() const
    {
        return this->id;
    }

    void setId(int id)
    {
        this->id = id;
    }

    double getSalario() const
    {
        return this->salario;
    }

    void setSalario(double salario)
    {
        if (salario < 0)
        {
            throw EmpleadoException("El salario no puede ser negativo.");
        }

        this->salario = salario;
    }
};


