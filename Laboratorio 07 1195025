// VARIABLES GLOBALES


Empleado** empleados = nullptr;
int cantidadEmpleados = 0;
int capacidadEmpleados = 0;


void redimensionarArreglo()
{
    int nuevaCapacidad = (capacidadEmpleados == 0) ? 4 : capacidadEmpleados * 2;
    Empleado** nuevoArreglo = new Empleado * [nuevaCapacidad];

    for (int i = 0; i < cantidadEmpleados; i++)
    {
        nuevoArreglo[i] = empleados[i];
    }

    delete[] empleados;
    empleados = nuevoArreglo;
    capacidadEmpleados = nuevaCapacidad;
}

void agregarEmpleado(Empleado* nuevoEmpleado)
{
    if (cantidadEmpleados == capacidadEmpleados)
    {
        redimensionarArreglo();
    }

    empleados[cantidadEmpleados] = nuevoEmpleado;
    cantidadEmpleados++;
}

int buscarIndicePorId(int id)
{
    for (int i = 0; i < cantidadEmpleados; i++)
    {
        if (empleados[i]->getId() == id)
        {
            return i;
        }
    }

    return -1;
}

Empleado* buscarEmpleadoPorId(int id)
{
    int indice = buscarIndicePorId(id);

    if (indice == -1)
    {
        throw EmpleadoException("No existe un empleado con el ID indicado.");
    }

    return empleados[indice];
}

void eliminarEmpleadoPorId(int id)
{
    int indice = buscarIndicePorId(id);

    if (indice == -1)
    {
        throw EmpleadoException("No existe un empleado con el ID indicado.");
    }

    delete empleados[indice];

    for (int i = indice; i < cantidadEmpleados - 1; i++)
    {
        empleados[i] = empleados[i + 1];
    }

    cantidadEmpleados--;
}

void liberarTodosLosEmpleados()
{
    for (int i = 0; i < cantidadEmpleados; i++)
    {
        delete empleados[i];
    }

    delete[] empleados;
    empleados = nullptr;
    cantidadEmpleados = 0;
    capacidadEmpleados = 0;
}


// REPORTES


void reporteMostrarTodos(Empleado** arreglo, int cantidad)
{
    if (cantidad == 0)
    {
        cout << "No hay empleados registrados." << endl;
        return;
    }

    cout << "\n=== LISTADO DE EMPLEADOS ===" << endl;

    for (int i = 0; i < cantidad; i++)
    {
        arreglo[i]->mostrarInfo();
    }
}

void reporteSalarioTotal(Empleado** arreglo, int cantidad)
{
    double total = 0;

    for (int i = 0; i < cantidad; i++)
    {
        total += arreglo[i]->getSalario();
    }

    cout << "\n=== SALARIO TOTAL ===" << endl;
    cout << "Salario total de la planilla: Q" << fixed << setprecision(2) << total << endl;
}

void reporteContarPorTipo(Empleado** arreglo, int cantidad)
{
    int administrativos = 0;
    int tecnicos = 0;
    int ventas = 0;

    for (int i = 0; i < cantidad; i++)
    {
        string tipo = arreglo[i]->getTipo();

        if (tipo == "Administrativo")
        {
            administrativos++;
        }
        else if (tipo == "Tecnico")
        {
            tecnicos++;
        }
        else if (tipo == "Ventas")
        {
            ventas++;
        }
    }

    cout << "\n=== EMPLEADOS POR TIPO ===" << endl;
    cout << "Administrativos: " << administrativos << endl;
    cout << "Tecnicos       : " << tecnicos << endl;
    cout << "Ventas         : " << ventas << endl;
}

void reporteSalarioMayorAValor(Empleado** arreglo, int cantidad)
{
    if (cantidad == 0)
    {
        cout << "No hay empleados registrados." << endl;
        return;
    }

    double valor;
    cout << "Ingrese el valor de referencia: Q";
    cin >> valor;

    cout << "\n=== EMPLEADOS CON SALARIO MAYOR A Q" << fixed << setprecision(2) << valor << " ===" << endl;
    bool encontroAlguno = false;

    for (int i = 0; i < cantidad; i++)
    {
        if (arreglo[i]->getSalario() > valor)
        {
            arreglo[i]->mostrarInfo();
            encontroAlguno = true;
        }
    }

    if (!encontroAlguno)
    {
        cout << "Ningun empleado supera ese salario." << endl;
    }
}

typedef void (*FuncionReporte)(Empleado**, int);

FuncionReporte reportes[4] = {
    reporteMostrarTodos,
    reporteSalarioTotal,
    reporteContarPorTipo,
    reporteSalarioMayorAValor
};

// ACTUALIZACION DE SALARIO MEDIANTE PUNTEROS A FUNCIONES
// Firma comun: void (Empleado*, double)


void aumentarSalario(Empleado* empleado, double porcentaje)
{
    double nuevoSalario = empleado->getSalario() + (empleado->getSalario() * porcentaje / 100.0);
    empleado->setSalario(nuevoSalario);
}

void disminuirSalario(Empleado* empleado, double porcentaje)
{
    double nuevoSalario = empleado->getSalario() - (empleado->getSalario() * porcentaje / 100.0);
    empleado->setSalario(nuevoSalario);
}

void cambiarSalario(Empleado* empleado, double nuevoValor)
{
    empleado->setSalario(nuevoValor);
}

typedef void (*FuncionSalario)(Empleado*, double);


// ORDENAMIENTO 


void ordenarPorSalarioAscendente()
{
    for (int i = 0; i < cantidadEmpleados - 1; i++)
    {
        for (int j = 0; j < cantidadEmpleados - 1 - i; j++)
        {
            if (empleados[j]->getSalario() > empleados[j + 1]->getSalario())
            {
                Empleado* temporal = empleados[j];
                empleados[j] = empleados[j + 1];
                empleados[j + 1] = temporal;
            }
        }
    }
}

void ordenarPorSalarioDescendente()
{
    for (int i = 0; i < cantidadEmpleados - 1; i++)
    {
        for (int j = 0; j < cantidadEmpleados - 1 - i; j++)
        {
            if (empleados[j]->getSalario() < empleados[j + 1]->getSalario())
            {
                Empleado* temporal = empleados[j];
                empleados[j] = empleados[j + 1];
                empleados[j + 1] = temporal;
            }
        }
    }
}

void ordenarPorNombre()
{
