    }
}


// ESTADISTICAS


void mostrarEstadisticas()
{
    if (cantidadEmpleados == 0)
    {
        cout << "No hay empleados registrados." << endl;
        return;
    }

    double sumaSalarios = 0;
    Empleado* mayorSalario = empleados[0];
    Empleado* menorSalario = empleados[0];
    int administrativos = 0;
    int tecnicos = 0;
    int ventas = 0;

    for (int i = 0; i < cantidadEmpleados; i++)
    {
        double salarioActual = empleados[i]->getSalario();
        sumaSalarios += salarioActual;

        if (salarioActual > mayorSalario->getSalario())
        {
            mayorSalario = empleados[i];
        }

        if (salarioActual < menorSalario->getSalario())
        {
            menorSalario = empleados[i];
        }

        string tipo = empleados[i]->getTipo();

        if (tipo == "Administrativo")
        {
            administrativos++;
        }
        else if (tipo == "Tecnico")
        {
            tecnicos++;
        }
        else if (tipo == "Ventas")
        {
            ventas++;
        }
    }

    double promedio = sumaSalarios / cantidadEmpleados;

    cout << "\n=== ESTADISTICAS ===" << endl;
    cout << "Salario promedio       : Q" << fixed << setprecision(2) << promedio << endl;
    cout << "Empleado mayor salario : " << mayorSalario->getNombre() << " (Q" << mayorSalario->getSalario() << ")" << endl;
    cout << "Empleado menor salario : " << menorSalario->getNombre() << " (Q" << menorSalario->getSalario() << ")" << endl;
    cout << "Empleados administrativos: " << administrativos << endl;
    cout << "Empleados tecnicos        : " << tecnicos << endl;
    cout << "Empleados de ventas       : " << ventas << endl;
}


