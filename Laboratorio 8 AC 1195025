// Excepcion personalizada

class OperacionInvalidaException : public runtime_error
{
public:
    explicit OperacionInvalidaException(const string& mensaje)
        : runtime_error(mensaje)
    {
    }
};


// Funciones recursivas
// 1. Calcular potencia
int potencia(int base, int exponente)
{
    if (exponente < 0)
    {
        throw OperacionInvalidaException("El exponente no puede ser negativo.");
    }

    if (exponente == 0)
    {
        return 1;
    }

    return base * potencia(base, exponente - 1);
}

// 2. Contar digitos
int contarDigitos(int n)
{
    if (n < 0)
    {
        throw OperacionInvalidaException("El numero debe ser entero positivo.");
    }

    if (n < 10)
    {
        return 1;
    }

    return 1 + contarDigitos(n / 10);
}

// 3. Invertir un numero
int invertirNumero(int n, int invertido)
{
    if (n < 0)
    {
        throw OperacionInvalidaException("El numero debe ser entero positivo.");
    }

    if (n == 0)
    {
        return invertido;
    }

    return invertirNumero(n / 10, invertido * 10 + n % 10);
}

// 4. Sumar los digitos
int sumaDigitos(int n)
{
    if (n < 0)
    {
        throw OperacionInvalidaException("El numero debe ser entero positivo.");
    }

    if (n == 0)
    {
        return 0;
    }

    return n % 10 + sumaDigitos(n / 10);
}

// 5. Obtener el digito mayor
int digitoMayor(int n)
{
    if (n < 0)
    {
        throw OperacionInvalidaException("El numero debe ser entero positivo.");
    }

    if (n < 10)
    {
        return n;
    }

    int ultimoDigito = n % 10;
    int mayorResto = digitoMayor(n / 10);

    if (ultimoDigito > mayorResto)
    {
        return ultimoDigito;
    }

    return mayorResto;
}



int operarPotencia(int base, int exponente)
{
    return potencia(base, exponente);
}

int operarContarDigitos(int n, int noUsado)
{
    return contarDigitos(n);
}

int operarInvertirNumero(int n, int invertidoInicial)
{
    return invertirNumero(n, invertidoInicial);
}

int operarSumaDigitos(int n, int noUsado)
{
    return sumaDigitos(n);
}

int operarDigitoMayor(int n, int noUsado)
{
    return digitoMayor(n);
}

// Tipo de puntero a funcion utilizado por el arreglo
