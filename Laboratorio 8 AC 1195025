            case 3:
            {
                int numero = 0;
                cout << "Ingrese un numero entero positivo: ";
                cin >> numero;

                resultado = operaciones[indice](numero, 0);
                cout << numero << " -> " << resultado << endl;
                break;
            }
            case 4:
            {
                int numero = 0;
                cout << "Ingrese un numero entero positivo: ";
                cin >> numero;

                resultado = operaciones[indice](numero, 0);
                cout << "sumaDigitos(" << numero << ") = " << resultado << endl;
                break;
            }
            case 5:
            {
