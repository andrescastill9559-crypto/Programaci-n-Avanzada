// Ejercicio 1: Resistencia equivalente de una red en escalera


double resistenciaEquivalente(double resistenciaSerie, double resistenciaParalelo, int numeroEtapas)
{
    if (resistenciaSerie <= 0 || resistenciaParalelo <= 0)
    {
        throw ExcepcionValorInvalido("Las resistencias Rs y Rp deben ser valores positivos.");
    }

    if (numeroEtapas <= 0)
    {
        throw ExcepcionValorInvalido("El numero de etapas debe ser mayor a cero.");
    }

    
    if (numeroEtapas == 1)
    {
        double resultado = resistenciaSerie + resistenciaParalelo;
        cout << "  Etapa 1 (caso base): R_eq(1) = Rs + Rp = "
            << resistenciaSerie << " + " << resistenciaParalelo
            << " = " << resultado << " ohm" << endl;
        return resultado;
    }

    double resistenciaAnterior = resistenciaEquivalente(resistenciaSerie, resistenciaParalelo, numeroEtapas - 1);
    double resultado = resistenciaSerie
        + (resistenciaParalelo * resistenciaAnterior) / (resistenciaParalelo + resistenciaAnterior);

    cout << "  Etapa " << numeroEtapas << ": R_eq(" << numeroEtapas
        << ") = Rs + (Rp * R_eq(" << numeroEtapas - 1 << ")) / (Rp + R_eq(" << numeroEtapas - 1 << "))" << endl;
    cout << "  Etapa " << numeroEtapas << ": R_eq(" << numeroEtapas << ") = "
        << resistenciaSerie << " + (" << resistenciaParalelo << " * " << resistenciaAnterior
        << ") / (" << resistenciaParalelo << " + " << resistenciaAnterior
        << ") = " << resultado << " ohm" << endl;

    return resultado;
}


// Ejercicio 2: Verificacion de palabra palindroma (recursivo)


bool esPalindromaRecursivo(const string& palabra, int inicio, int fin)
{
    if (inicio >= fin)
    {
        return true;
    }

    if (palabra[inicio] != palabra[fin])
    {
        return false;
    }

    return esPalindromaRecursivo(palabra, inicio + 1, fin - 1);
}

bool esPalindroma(const string& palabra)
{
    if (palabra.empty())
    {
        throw ExcepcionCadenaInvalida("La palabra no puede estar vacia.");
    }

    for (char caracter : palabra)
    {
        if (!isalpha(static_cast<unsigned char>(caracter)))
        {
            throw ExcepcionCadenaInvalida("La palabra solo debe contener letras.");
        }
    }

    string palabraMinuscula = palabra;
    for (size_t i = 0; i < palabraMinuscula.size(); i++)
    {
        palabraMinuscula[i] = static_cast<char>(tolower(static_cast<unsigned char>(palabraMinuscula[i])));
    }

    return esPalindromaRecursivo(palabraMinuscula, 0, static_cast<int>(palabraMinuscula.size()) - 1);
}


// Funciones auxiliares de entrada validada


double leerDoublePositivo(const string& mensaje)
{
    double valor;
    while (true)
    {
        cout << mensaje;
        cin >> valor;

        if (cin.fail())
        {
            cin.clear();
            cin.ignore(10000, '\n');
            cout << "Entrada invalida. Ingrese un numero." << endl;
            continue;
        }

        if (valor <= 0)
        {
            cout << "El valor debe ser positivo." << endl;
            continue;
        }

        return valor;
    }
}

int leerEnteroPositivo(const string& mensaje)
{
