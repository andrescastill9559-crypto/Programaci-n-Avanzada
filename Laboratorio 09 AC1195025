// Programa principal

void ejecutarEjercicioResistencia()
{
    cout << "\n--- Resistencia equivalente de una red en escalera ---" << endl;

    double resistenciaSerie = leerDoublePositivo("Ingrese Rs (resistencia en serie, ohm): ");
    double resistenciaParalelo = leerDoublePositivo("Ingrese Rp (resistencia en paralelo, ohm): ");
    int numeroEtapas = leerEnteroPositivo("Ingrese el numero de etapas (n): ");

    try
    {
        cout << "\nPasos de la recursion:" << endl;
        double resultado = resistenciaEquivalente(resistenciaSerie, resistenciaParalelo, numeroEtapas);
        cout << "\nResistencia equivalente total: " << resultado << " ohm" << endl;
    }
    catch (ExcepcionValorInvalido& error)
    {
        cout << "Error: " << error.obtenerMensaje() << endl;
    }
}

void ejecutarEjercicioPalindroma()
{
    cout << "\n--- Verificacion de palabra palindroma ---" << endl;

    string palabra;
    cout << "Ingrese una palabra: ";
    cin >> palabra;

    try
    {
        if (esPalindroma(palabra))
        {
            cout << "\"" << palabra << "\" es palindroma." << endl;
        }
        else
        {
            cout << "\"" << palabra << "\" no es palindroma." << endl;
        }
    }
    catch (ExcepcionCadenaInvalida& error)
    {
        cout << "Error: " << error.obtenerMensaje() << endl;
    }
}

