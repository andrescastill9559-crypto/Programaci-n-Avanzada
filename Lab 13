                << setw(8) << p.getAnioEstreno() << setw(8) << p.getCopiasDisponibles() << endl;
        }
    }

    void mostrarClientes() const
    {
        this->validarClientesNoVacio();
        cout << left << setw(8) << "ID" << setw(22) << "Nombre" << setw(30) << "Correo" << setw(10) << "Alquileres" << endl;
        cout << string(70, '-') << endl;
        for (size_t i = 0; i < this->clientes.size(); i++)
        {
            const Cliente& c = this->clientes[i];
            cout << left << setw(8) << c.getId() << setw(22) << c.getNombre() << setw(30) << c.getCorreo()
                << setw(10) << c.getTotalAlquileres() << endl;
        }
    }

    void mostrarHistorial() const
    {
        if (this->historial.empty())
        {
            throw EstructuraVaciaExcepcion("El historial de alquileres esta vacio.");
        }
        cout << left << setw(5) << "ID" << setw(18) << "Pelicula" << setw(16) << "Cliente"
            << setw(13) << "Alquiler" << setw(13) << "Devolucion" << setw(6) << "Dias" << setw(10) << "Monto" << endl;
        cout << string(81, '-') << endl;
        for (size_t i = 0; i < this->historial.size(); i++)
        {
            const Alquiler& a = this->historial[i];
            cout << left << setw(5) << a.getIdAlquiler() << setw(18) << a.getTituloPelicula()
                << setw(16) << a.getNombreCliente() << setw(13) << a.getFechaAlquiler()
                << setw(13) << a.getFechaDevolucion() << setw(6) << a.getDias()
                << "Q" << fixed << setprecision(2) << a.getMontoTotal() << endl;
        }
    }

    // Se copia la pila para poder recorrerla sin alterar la original
    void mostrarPilaDevoluciones() const
    {
        if (this->devoluciones.empty())
        {
            throw EstructuraVaciaExcepcion("La pila de devoluciones esta vacia.");
        }
        stack<Alquiler> copia = this->devoluciones;
        cout << "(Tope de la pila = proximo en devolverse)" << endl;
        while (!copia.empty())
        {
            Alquiler a = copia.top();
            copia.pop();
            cout << " - Alquiler #" << a.getIdAlquiler() << ": \"" << a.getTituloPelicula()
                << "\" (" << a.getNombreCliente() << ")" << endl;
        }
    }

    // Se copia la cola para poder recorrerla sin alterar la original
    void mostrarColaReservas() const
    {
        if (this->reservas.empty())
        {
            throw EstructuraVaciaExcepcion("La cola de reservas esta vacia.");
        }
        queue<Reserva> copia = this->reservas;
        cout << "(Frente de la cola = proximo en ser atendido)" << endl;
        int posicion = 1;
        while (!copia.empty())
        {
            Reserva r = copia.front();
            copia.pop();
            cout << " " << posicion << ". Cliente " << r.getIdCliente() << " espera \""
                << r.getTituloPelicula() << "\"" << endl;
            posicion++;
        }
    }
};

// LECTURA DE DATOS CON VALIDACION

string leerTexto(const string& mensaje)
{
    string valor;
    do
    {
        cout << mensaje;
        getline(cin, valor);
        if (valor.empty())
        {
            cout << "  El valor no puede estar vacio." << endl;
        }
    } while (valor.empty());
    return valor;
}

int leerEntero(const string& mensaje, int minimo, int maximo)
{
    while (true)
    {
        cout << mensaje;
        string linea;
        getline(cin, linea);
        try
        {
            size_t posicion = 0;
            int valor = stoi(linea, &posicion);
            if (posicion != linea.size())
            {
                throw invalid_argument("basura al final");
            }
            if (valor < minimo || valor > maximo)
            {
                cout << "  Ingrese un numero entre " << minimo << " y " << maximo << "." << endl;
                continue;
            }
            return valor;
        }
        catch (const exception&)
        {
            cout << "  Entrada invalida. Ingrese un numero entero." << endl;
        }
    }
}

double leerDecimal(const string& mensaje, double minimo)
{
    while (true)
    {
        cout << mensaje;
        string linea;
        getline(cin, linea);
        try
        {
            size_t posicion = 0;
            double valor = stod(linea, &posicion);
            if (posicion != linea.size())
            {
                throw invalid_argument("basura al final");
            }
            if (valor < minimo)
            {
                cout << "  El valor debe ser mayor o igual a " << minimo << "." << endl;
                continue;
            }
            return valor;
        }
        catch (const exception&)
        {
            cout << "  Entrada invalida. Ingrese un numero (ej. 12.50)." << endl;
        }
    }
}

// Valida el formato dd/mm/aaaa de forma sencilla
string leerFecha(const string& mensaje)
{
    while (true)
    {
        string fecha = leerTexto(mensaje + " (dd/mm/aaaa): ");
        bool valida = (fecha.size() == 10 && fecha[2] == '/' && fecha[5] == '/');
        for (size_t i = 0; valida && i < fecha.size(); i++)
        {
            if (i != 2 && i != 5 && !isdigit((unsigned char)fecha[i]))
            {
                valida = false;
            }
        }
        if (valida)
        {
            return fecha;
        }
        cout << "  Formato de fecha invalido." << endl;
    }
}

string leerCorreo(const string& mensaje)
{
    while (true)
    {
        string correo = leerTexto(mensaje);
        size_t arroba = correo.find('@');
        if (arroba != string::npos && arroba > 0 && correo.find('.', arroba) != string::npos)
        {
            return correo;
        }
        cout << "  Correo invalido (ej. usuario@correo.com)." << endl;
    }
}


// MENUS

void menuGestion(Tienda& tienda)
{
    int opcion;
    do
    {
        cout << "\n--- GESTION ---" << endl;
        cout << "1. Agregar pelicula" << endl;
        cout << "2. Eliminar pelicula" << endl;
        cout << "3. Registrar cliente" << endl;
        cout << "4. Mostrar catalogo" << endl;
        cout << "5. Mostrar clientes" << endl;
        cout << "0. Volver" << endl;
        opcion = leerEntero("Opcion: ", 0, 5);

        try
        {
            switch (opcion)
            {
            case 1:
            {
                string titulo = leerTexto("Titulo: ");
                string genero = leerTexto("Genero: ");
                double precio = leerDecimal("Precio de alquiler (Q): ", 0.0);
                int anio = leerEntero("Anio de estreno: ", 1888, 2100);
                int copias = leerEntero("Copias disponibles: ", 0, 1000);
                tienda.agregarPelicula(Pelicula(titulo, genero, precio, anio, copias));
                cout << "Pelicula agregada." << endl;
                break;
            }
            case 2:
            {
                tienda.validarCatalogoNoVacio();
                string titulo = leerTexto("Titulo de la pelicula a eliminar: ");
                tienda.eliminarPelicula(titulo);
                cout << "Pelicula eliminada." << endl;
                break;
            }
            case 3:
            {
                string nombre = leerTexto("Nombre: ");
                int id = leerEntero("ID: ", 1, 999999999);
                string correo = leerCorreo("Correo electronico: ");
                tienda.registrarCliente(Cliente(nombre, id, correo));
                cout << "Cliente registrado." << endl;
                break;
            }
            case 4:
                tienda.mostrarCatalogo();
                break;
            case 5:
                tienda.mostrarClientes();
                break;
            }
        }
        catch (const ExcepcionTienda& e)
        {
            cout << "Error: " << e.what() << endl;
        }
    } while (opcion != 0);
}

void menuAlquileres(Tienda& tienda)
{
    int opcion;
    do
    {
        cout << "\n--- ALQUILERES ---" << endl;
        cout << "1. Registrar alquiler" << endl;
        cout << "2. Registrar devolucion (ultimo alquiler)" << endl;
        cout << "3. Registrar solicitud de reserva" << endl;
        cout << "4. Procesar solicitud (primero en la cola)" << endl;
        cout << "5. Ver historial de alquileres" << endl;
        cout << "6. Ver pila de devoluciones" << endl;
        cout << "7. Ver cola de reservas" << endl;
        cout << "0. Volver" << endl;
        opcion = leerEntero("Opcion: ", 0, 7);

        try
        {
            switch (opcion)
            {
            case 1:
            {
                tienda.validarCatalogoNoVacio();
                tienda.mostrarCatalogo();
                int idCliente = leerEntero("ID del cliente: ", 1, 999999999);
                string titulo = leerTexto("Titulo de la pelicula: ");
                string fecha = leerFecha("Fecha de alquiler");
                int dias = leerEntero("Dias de alquiler: ", 1, 60);
                tienda.registrarAlquiler(idCliente, titulo, fecha, dias);
                break;
            }
            case 2:
            {
                string fecha = leerFecha("Fecha de devolucion");
                tienda.registrarDevolucion(fecha);
                break;
            }
            case 3:
            {
                int idCliente = leerEntero("ID del cliente: ", 1, 999999999);
                string titulo = leerTexto("Titulo de la pelicula agotada: ");
                tienda.registrarReserva(idCliente, titulo);
                break;
            }
            case 4:
            {
                if (tienda.cantidadReservas() == 0)
                {
                    throw EstructuraVaciaExcepcion("La cola de reservas esta vacia.");
                }
                string fecha = leerFecha("Fecha de alquiler");
                int dias = leerEntero("Dias de alquiler: ", 1, 60);
                tienda.procesarSolicitud(fecha, dias);
                break;
            }
            case 5:
                tienda.mostrarHistorial();
                break;
            case 6:
                tienda.mostrarPilaDevoluciones();
                break;
            case 7:
                tienda.mostrarColaReservas();
                break;
            }
        }
        catch (const ExcepcionTienda& e)
        {
            cout << "Error: " << e.what() << endl;
        }
    } while (opcion != 0);
}

void menuOrdenamientos(Tienda& tienda)
{
    int opcion;
    do
    {
        cout << "\n--- ORDENAMIENTOS ---" << endl;
        cout << "1. Por titulo (Burbuja)" << endl;
        cout << "2. Por titulo (Quick Sort)" << endl;
        cout << "3. Por genero (Quick Sort)" << endl;
        cout << "4. Por precio de alquiler (Shell Sort)" << endl;
        cout << "5. Por anio de estreno (Shell Sort)" << endl;
        cout << "6. Pelicula mas cara (Seleccion)" << endl;
        cout << "7. Cliente con mas alquileres (Seleccion)" << endl;
        cout << "0. Volver" << endl;
        opcion = leerEntero("Opcion: ", 0, 7);

        try
        {
            if (opcion >= 1 && opcion <= 6)
            {
                tienda.validarCatalogoNoVacio();
                cout << "\n>>> CATALOGO ANTES DEL ORDENAMIENTO" << endl;
                tienda.mostrarCatalogo();

                switch (opcion)
                {
                case 1: tienda.ordenarPorTituloBurbuja(); break;
                case 2: tienda.ordenarPorTituloQuick(); break;
                case 3: tienda.ordenarPorGeneroQuick(); break;
                case 4: tienda.ordenarPorPrecioShell(); break;
                case 5: tienda.ordenarPorAnioShell(); break;
                case 6: tienda.ordenarPorPrecioSeleccion(); break;
                }

                cout << "\n>>> CATALOGO DESPUES DEL ORDENAMIENTO" << endl;
                tienda.mostrarCatalogo();

                if (opcion == 6)
                {
                    Pelicula masCara = tienda.getPrimeraPelicula();
                    cout << "\nLa pelicula mas cara es \"" << masCara.getTitulo() << "\" (Q"
                        << fixed << setprecision(2) << masCara.getPrecioAlquiler() << ")." << endl;
                }
            }
            else if (opcion == 7)
            {
                tienda.validarClientesNoVacio();
                cout << "\n>>> CLIENTES ANTES DEL ORDENAMIENTO" << endl;
                tienda.mostrarClientes();
                tienda.ordenarClientesPorAlquileresSeleccion();
                cout << "\n>>> CLIENTES DESPUES DEL ORDENAMIENTO" << endl;
                tienda.mostrarClientes();

                Cliente top = tienda.getPrimerCliente();
                cout << "\nEl cliente con mas alquileres es " << top.getNombre() << " ("
                    << top.getTotalAlquileres() << ")." << endl;
            }
        }
        catch (const ExcepcionTienda& e)
        {
            cout << "Error: " << e.what() << endl;
        }
    } while (opcion != 0);
}

