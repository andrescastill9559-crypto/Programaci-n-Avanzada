        this->catalogo.push_back(Pelicula("Toy Story", "Animacion", 10.00, 1995, 5));
        this->catalogo.push_back(Pelicula("Avatar", "Ciencia Ficcion", 18.00, 2009, 0));
        this->catalogo.push_back(Pelicula("Coco", "Animacion", 16.00, 2017, 3));
        this->catalogo.push_back(Pelicula("Gladiador", "Accion", 13.00, 2000, 1));
        this->catalogo.push_back(Pelicula("Scream", "Terror", 11.00, 1996, 1));
