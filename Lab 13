// COMPARADORES (criterio de ordenamiento: true si "a" va antes que "b")

typedef bool (*Comparador)(const Pelicula&, const Pelicula&);

bool precedePorTitulo(const Pelicula& a, const Pelicula& b)
{
    return aMinusculas(a.getTitulo()) < aMinusculas(b.getTitulo());
}

bool precedePorGenero(const Pelicula& a, const Pelicula& b)
{
    string generoA = aMinusculas(a.getGenero());
    string generoB = aMinusculas(b.getGenero());
    if (generoA != generoB)
    {
        return generoA < generoB;
    }
    return aMinusculas(a.getTitulo()) < aMinusculas(b.getTitulo());
}

bool precedePorPrecio(const Pelicula& a, const Pelicula& b)
{
    return a.getPrecioAlquiler() < b.getPrecioAlquiler();
}

bool precedePorAnio(const Pelicula& a, const Pelicula& b)
{
    return a.getAnioEstreno() < b.getAnioEstreno();
}

bool precedePorPrecioDescendente(const Pelicula& a, const Pelicula& b)
{
    return a.getPrecioAlquiler() > b.getPrecioAlquiler();
}


// CLASE TIENDA (clase gestora)

class Tienda
{
private:
    vector<Pelicula> catalogo;     // Lista
    vector<Cliente> clientes;      // Lista
    vector<Alquiler> historial;    // Lista
    stack<Alquiler> devoluciones;  // Pila (LIFO)
    queue<Reserva> reservas;       // Cola (FIFO)
    int siguienteIdAlquiler;

    // Busquedas internas
    int buscarIndicePelicula(const string& titulo) const
    {
        string buscado = aMinusculas(titulo);
        for (size_t i = 0; i < this->catalogo.size(); i++)
        {
            if (aMinusculas(this->catalogo[i].getTitulo()) == buscado)
            {
                return (int)i;
            }
        }
        return -1;
    }

    int buscarIndiceCliente(int id) const
    {
        for (size_t i = 0; i < this->clientes.size(); i++)
        {
            if (this->clientes[i].getId() == id)
            {
                return (int)i;
            }
        }
        return -1;
    }

    // Algoritmos de ordenamiento

    // Burbuja (Bubble Sort): compara pares adyacentes e intercambia
    void burbuja(vector<Pelicula>& v, Comparador precede)
    {
        int n = (int)v.size();
        for (int i = 0; i < n - 1; i++)
        {
            bool huboIntercambio = false;
            for (int j = 0; j < n - i - 1; j++)
            {
                if (precede(v[j + 1], v[j]))
                {
                    swap(v[j], v[j + 1]);
                    huboIntercambio = true;
                }
            }
            if (!huboIntercambio)
            {
                break; // ya esta ordenado
            }
        }
    }

    // Seleccion (Selection Sort): busca el elemento que debe ir en la posicion i
    void seleccion(vector<Pelicula>& v, Comparador precede)
    {
        int n = (int)v.size();
        for (int i = 0; i < n - 1; i++)
        {
            int indiceElegido = i;
            for (int j = i + 1; j < n; j++)
            {
                if (precede(v[j], v[indiceElegido]))
                {
                    indiceElegido = j;
                }
            }
            if (indiceElegido != i)
            {
                swap(v[i], v[indiceElegido]);
            }
        }
    }

    // Shell Sort: insercion con saltos (brechas) decrecientes
    void shell(vector<Pelicula>& v, Comparador precede)
    {
        int n = (int)v.size();
        for (int brecha = n / 2; brecha > 0; brecha /= 2)
        {
            for (int i = brecha; i < n; i++)
            {
                Pelicula temporal = v[i];
                int j = i;
                while (j >= brecha && precede(temporal, v[j - brecha]))
                {
                    v[j] = v[j - brecha];
                    j -= brecha;
                }
                v[j] = temporal;
            }
        }
    }

    // Quick Sort: particion con pivote al final (esquema de Lomuto)
    int particionar(vector<Pelicula>& v, int bajo, int alto, Comparador precede)
    {
        Pelicula pivote = v[alto];
        int i = bajo - 1;
        for (int j = bajo; j < alto; j++)
        {
            if (precede(v[j], pivote))
            {
                i++;
                swap(v[i], v[j]);
            }
        }
        swap(v[i + 1], v[alto]);
        return i + 1;
    }

    void quickSort(vector<Pelicula>& v, int bajo, int alto, Comparador precede)
    {
        if (bajo < alto)
        {
            int indicePivote = this->particionar(v, bajo, alto, precede);
            this->quickSort(v, bajo, indicePivote - 1, precede);
            this->quickSort(v, indicePivote + 1, alto, precede);
        }
    }

