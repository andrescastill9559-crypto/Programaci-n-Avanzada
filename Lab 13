// FUNCIONES AUXILIARES

string aMinusculas(const string& texto)
{
    string resultado = texto;
    for (size_t i = 0; i < resultado.size(); i++)
    {
        resultado[i] = (char)tolower((unsigned char)resultado[i]);
    }
    return resultado;
}


// CLASE PELICULA

class Pelicula
{
private:
    string titulo;
    string genero;
    double precioAlquiler;
    int anioEstreno;
    int copiasDisponibles;

public:
    Pelicula()
    {
        this->titulo = "";
        this->genero = "";
        this->precioAlquiler = 0.0;
        this->anioEstreno = 0;
        this->copiasDisponibles = 0;
    }

    Pelicula(const string& titulo, const string& genero, double precioAlquiler, int anioEstreno, int copiasDisponibles)
    {
        this->titulo = titulo;
        this->genero = genero;
        this->precioAlquiler = precioAlquiler;
        this->anioEstreno = anioEstreno;
        this->copiasDisponibles = copiasDisponibles;
    }

    string getTitulo() const { return this->titulo; }
    string getGenero() const { return this->genero; }
    double getPrecioAlquiler() const { return this->precioAlquiler; }
    int getAnioEstreno() const { return this->anioEstreno; }
    int getCopiasDisponibles() const { return this->copiasDisponibles; }

    void setTitulo(const string& titulo) { this->titulo = titulo; }
    void setGenero(const string& genero) { this->genero = genero; }

    void setPrecioAlquiler(double precioAlquiler)
    {
        if (precioAlquiler < 0)
        {
            throw OperacionInvalidaExcepcion("El precio de alquiler no puede ser negativo.");
        }
        this->precioAlquiler = precioAlquiler;
    }

    void setAnioEstreno(int anioEstreno) { this->anioEstreno = anioEstreno; }

    void setCopiasDisponibles(int copiasDisponibles)
    {
        if (copiasDisponibles < 0)
        {
            throw OperacionInvalidaExcepcion("Las copias disponibles no pueden ser negativas.");
        }
        this->copiasDisponibles = copiasDisponibles;
    }
};


