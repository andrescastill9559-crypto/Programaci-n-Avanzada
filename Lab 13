    }

public:
    Tienda()
    {
        this->siguienteIdAlquiler = 1;
        this->cargarDatosIniciales();
    }

    // Validaciones publicas 
    void validarCatalogoNoVacio() const
    {
        if (this->catalogo.empty())
        {
            throw EstructuraVaciaExcepcion("El catalogo esta vacio.");
        }
    }

    void validarClientesNoVacio() const
    {
        if (this->clientes.empty())
        {
            throw EstructuraVaciaExcepcion("No hay clientes registrados.");
        }
    }

    int cantidadReservas() const { return (int)this->reservas.size(); }

    // Gestion de peliculas y clientes
    void agregarPelicula(const Pelicula& pelicula)
    {
        if (this->buscarIndicePelicula(pelicula.getTitulo()) != -1)
        {
            throw OperacionInvalidaExcepcion("Ya existe una pelicula con ese titulo.");
        }
        this->catalogo.push_back(pelicula);
    }

    void eliminarPelicula(const string& titulo)
    {
        this->validarCatalogoNoVacio();
        int indice = this->buscarIndicePelicula(titulo);
        if (indice == -1)
        {
            throw ElementoNoEncontradoExcepcion("La pelicula \"" + titulo + "\" no existe en el catalogo.");
        }
        this->catalogo.erase(this->catalogo.begin() + indice);
    }

    void registrarCliente(const Cliente& cliente)
    {
        if (this->buscarIndiceCliente(cliente.getId()) != -1)
        {
            throw OperacionInvalidaExcepcion("Ya existe un cliente con ese ID.");
        }
        this->clientes.push_back(cliente);
    }

    // Alquileres, devoluciones y reservas
    void registrarAlquiler(int idCliente, const string& titulo, const string& fecha, int dias)
    {
        this->validarCatalogoNoVacio();
        int indiceCliente = this->buscarIndiceCliente(idCliente);
        if (indiceCliente == -1)
        {
            throw ElementoNoEncontradoExcepcion("No existe un cliente con ese ID.");
        }
        int indicePelicula = this->buscarIndicePelicula(titulo);
        if (indicePelicula == -1)
        {
            throw ElementoNoEncontradoExcepcion("La pelicula \"" + titulo + "\" no existe en el catalogo.");
        }
        if (this->catalogo[indicePelicula].getCopiasDisponibles() <= 0)
        {
            throw OperacionInvalidaExcepcion("No hay copias disponibles. Puede registrar una solicitud de reserva.");
        }

        // a) asociar pelicula, cliente y fecha
        double monto = this->catalogo[indicePelicula].getPrecioAlquiler() * dias;
        Alquiler nuevo(this->siguienteIdAlquiler, this->catalogo[indicePelicula].getTitulo(),
            this->clientes[indiceCliente].getId(), this->clientes[indiceCliente].getNombre(),
            fecha, dias, monto);
        this->siguienteIdAlquiler++;

        // b) descontar una copia disponible
        this->catalogo[indicePelicula].setCopiasDisponibles(this->catalogo[indicePelicula].getCopiasDisponibles() - 1);
        this->clientes[indiceCliente].setTotalAlquileres(this->clientes[indiceCliente].getTotalAlquileres() + 1);

        // c) agregar al historial (lista) y a la pila de devoluciones
        this->historial.push_back(nuevo);
        this->devoluciones.push(nuevo);

        cout << "Alquiler #" << nuevo.getIdAlquiler() << " registrado. Monto total: Q"
            << fixed << setprecision(2) << monto << endl;
    }

    void registrarDevolucion(const string& fechaDevolucion)
    {
        if (this->devoluciones.empty())
        {
            throw EstructuraVaciaExcepcion("La pila de devoluciones esta vacia: no hay alquileres pendientes.");
        }

        // a) extraer el ultimo elemento de la pila
        Alquiler alquiler = this->devoluciones.top();
        this->devoluciones.pop();

        // actualizar el registro correspondiente en el historial
        for (size_t i = 0; i < this->historial.size(); i++)
        {
            if (this->historial[i].getIdAlquiler() == alquiler.getIdAlquiler())
            {
                this->historial[i].setFechaDevolucion(fechaDevolucion);
                this->historial[i].setDevuelto(true);
            }
        }

        // b) incrementar las copias disponibles (si la pelicula sigue en el catalogo)
        int indicePelicula = this->buscarIndicePelicula(alquiler.getTituloPelicula());
        if (indicePelicula != -1)
        {
            this->catalogo[indicePelicula].setCopiasDisponibles(
                this->catalogo[indicePelicula].getCopiasDisponibles() + 1);
            cout << "Devolucion registrada: \"" << alquiler.getTituloPelicula() << "\" (alquiler #"
                << alquiler.getIdAlquiler() << ", cliente " << alquiler.getNombreCliente() << ")." << endl;
        }
        else
        {
            cout << "Devolucion registrada, pero \"" << alquiler.getTituloPelicula()
                << "\" ya no esta en el catalogo (no se incrementan copias)." << endl;
        }
    }

    void registrarReserva(int idCliente, const string& titulo)
    {
        this->validarCatalogoNoVacio();
        if (this->buscarIndiceCliente(idCliente) == -1)
        {
            throw ElementoNoEncontradoExcepcion("No existe un cliente con ese ID.");
        }
        int indicePelicula = this->buscarIndicePelicula(titulo);
        if (indicePelicula == -1)
        {
            throw ElementoNoEncontradoExcepcion("La pelicula \"" + titulo + "\" no existe en el catalogo.");
        }
        if (this->catalogo[indicePelicula].getCopiasDisponibles() > 0)
        {
            throw OperacionInvalidaExcepcion("La pelicula tiene copias disponibles; no necesita reserva, alquilela directamente.");
        }

        // insertar al final de la cola
        this->reservas.push(Reserva(idCliente, this->catalogo[indicePelicula].getTitulo()));
        cout << "Reserva registrada. Posicion en la cola: " << this->reservas.size() << endl;
    }

    void procesarSolicitud(const string& fecha, int dias)
    {
        if (this->reservas.empty())
        {
            throw EstructuraVaciaExcepcion("La cola de reservas esta vacia.");
        }

        Reserva siguiente = this->reservas.front(); // primer cliente en la cola
        int indicePelicula = this->buscarIndicePelicula(siguiente.getTituloPelicula());

        if (indicePelicula == -1)
        {
            this->reservas.pop();
            throw OperacionInvalidaExcepcion("La pelicula reservada ya no existe en el catalogo. Solicitud descartada.");
        }
        if (this->catalogo[indicePelicula].getCopiasDisponibles() <= 0)
        {
            throw OperacionInvalidaExcepcion("Aun no hay copias de \"" + siguiente.getTituloPelicula()
                + "\". La solicitud permanece en la cola.");
        }

        this->reservas.pop();
        cout << "Atendiendo reserva del cliente " << siguiente.getIdCliente() << "..." << endl;
        this->registrarAlquiler(siguiente.getIdCliente(), siguiente.getTituloPelicula(), fecha, dias);
    }

    // Ordenamientos del catalogo
    void ordenarPorTituloBurbuja()
    {
        this->validarCatalogoNoVacio();
        this->burbuja(this->catalogo, precedePorTitulo);
    }

    void ordenarPorTituloQuick()
    {
        this->validarCatalogoNoVacio();
        this->quickSort(this->catalogo, 0, (int)this->catalogo.size() - 1, precedePorTitulo);
    }

    void ordenarPorGeneroQuick()
    {
        this->validarCatalogoNoVacio();
        this->quickSort(this->catalogo, 0, (int)this->catalogo.size() - 1, precedePorGenero);
    }

    void ordenarPorPrecioShell()
    {
        this->validarCatalogoNoVacio();
        this->shell(this->catalogo, precedePorPrecio);
    }

    void ordenarPorAnioShell()
    {
        this->validarCatalogoNoVacio();
        this->shell(this->catalogo, precedePorAnio);
    }

    // Seleccion: deja el catalogo de mayor a menor precio; la primera es la mas cara
    void ordenarPorPrecioSeleccion()
    {
        this->validarCatalogoNoVacio();
        this->seleccion(this->catalogo, precedePorPrecioDescendente);
    }

    // Seleccion: deja los clientes de mayor a menor numero de alquileres; el primero es el que mas alquila
    void ordenarClientesPorAlquileresSeleccion()
    {
        this->validarClientesNoVacio();
        int n = (int)this->clientes.size();
        for (int i = 0; i < n - 1; i++)
        {
            int indiceMayor = i;
            for (int j = i + 1; j < n; j++)
            {
                if (this->clientes[j].getTotalAlquileres() > this->clientes[indiceMayor].getTotalAlquileres())
                {
                    indiceMayor = j;
                }
            }
            if (indiceMayor != i)
            {
                swap(this->clientes[i], this->clientes[indiceMayor]);
            }
        }
    }

    Pelicula getPrimeraPelicula() const { return this->catalogo[0]; }
    Cliente getPrimerCliente() const { return this->clientes[0]; }

    // Reportes
    void mostrarCatalogo() const
    {
        this->validarCatalogoNoVacio();
        cout << left << setw(4) << "#" << setw(22) << "Titulo" << setw(18) << "Genero"
            << setw(10) << "Precio" << setw(8) << "Anio" << setw(8) << "Copias" << endl;
        cout << string(70, '-') << endl;
        for (size_t i = 0; i < this->catalogo.size(); i++)
