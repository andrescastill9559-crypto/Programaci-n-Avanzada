// TanqueEsferico

class TanqueEsferico : public Tanque
{
private:
    double radio;
    static const double PI;

public:
    TanqueEsferico();
    TanqueEsferico(double radio, double costoFijo, double costoPorM3);

    double getRadio() const;
    void setRadio(double radio);

    double calcularVolumen() override;
    void mostrarDimensiones() const override;
    void mostrarValoresIntermediosVolumen() const override;
};

const double TanqueEsferico::PI = 3.14159265358979323846;

TanqueEsferico::TanqueEsferico() : Tanque()
{
    this->radio = 0.0;
    this->tipo = "Esferico";
}

TanqueEsferico::TanqueEsferico(double radio, double costoFijo, double costoPorM3)
    : Tanque("Esferico", costoFijo, costoPorM3)
{
    this->setRadio(radio);
}

double TanqueEsferico::getRadio() const
{
    return this->radio;
}

void TanqueEsferico::setRadio(double radio)
{
    this->validarDimensionPositiva(radio, "radio");
    this->radio = radio;
}

double TanqueEsferico::calcularVolumen()
{
    this->volumen = (4.0 / 3.0) * TanqueEsferico::PI * std::pow(this->radio, 3);
    return this->volumen;
}

void TanqueEsferico::mostrarDimensiones() const
{
    std::cout << "  Radio: " << this->radio << " m" << std::endl;
}

void TanqueEsferico::mostrarValoresIntermediosVolumen() const
{
    std::cout << "  [DEBUG] Formula: volumen = (4/3) * PI * radio^3" << std::endl;
    std::cout << "  [DEBUG] radio = " << this->radio << std::endl;
    std::cout << "  [DEBUG] radio^3 = " << std::pow(this->radio, 3) << std::endl;
    std::cout << "  [DEBUG] (4/3) * PI = " << (4.0 / 3.0) * TanqueEsferico::PI << std::endl;
}

// TanqueCilindrico

// Tanque con forma de cilindro solido. volumen = PI * radio^2 * altura
class TanqueCilindrico : public Tanque
{
private:
    double radio;
    double altura;
    static const double PI;

public:
    TanqueCilindrico();
    TanqueCilindrico(double radio, double altura, double costoFijo, double costoPorM3);

    double getRadio() const;
    void setRadio(double radio);

    double getAltura() const;
    void setAltura(double altura);

    double calcularVolumen() override;
    void mostrarDimensiones() const override;
    void mostrarValoresIntermediosVolumen() const override;
};

const double TanqueCilindrico::PI = 3.14159265358979323846;

TanqueCilindrico::TanqueCilindrico() : Tanque()
{
    this->radio = 0.0;
    this->altura = 0.0;
    this->tipo = "Cilindrico";
}

TanqueCilindrico::TanqueCilindrico(double radio, double altura, double costoFijo, double costoPorM3)
    : Tanque("Cilindrico", costoFijo, costoPorM3)
{
    this->setRadio(radio);
    this->setAltura(altura);
}

double TanqueCilindrico::getRadio() const
{
    return this->radio;
}

void TanqueCilindrico::setRadio(double radio)
{
    this->validarDimensionPositiva(radio, "radio");
    this->radio = radio;
}

double TanqueCilindrico::getAltura() const
{
    return this->altura;
}

void TanqueCilindrico::setAltura(double altura)
{
    this->validarDimensionPositiva(altura, "altura");
    this->altura = altura;
}

double TanqueCilindrico::calcularVolumen()
{
    this->volumen = TanqueCilindrico::PI * std::pow(this->radio, 2) * this->altura;
    return this->volumen;
}

void TanqueCilindrico::mostrarDimensiones() const
{
    std::cout << "  Radio: " << this->radio << " m" << std::endl;
    std::cout << "  Altura: " << this->altura << " m" << std::endl;
}

void TanqueCilindrico::mostrarValoresIntermediosVolumen() const
{
    std::cout << "  [DEBUG] Formula: volumen = PI * radio^2 * altura" << std::endl;
    std::cout << "  [DEBUG] radio = " << this->radio << ", altura = " << this->altura << std::endl;
    std::cout << "  [DEBUG] radio^2 = " << std::pow(this->radio, 2) << std::endl;
    std::cout << "  [DEBUG] PI * radio^2 * altura = " << TanqueCilindrico::PI * std::pow(this->radio, 2) * this->altura << std::endl;
}

// TanqueCilindricoHueco

class TanqueCilindricoHueco : public Tanque
{
private:
    double radioExterno;
    double radioInterno;
    double altura;
    static const double PI;

public:
    TanqueCilindricoHueco();
    TanqueCilindricoHueco(double radioExterno, double radioInterno, double altura, double costoFijo, double costoPorM3);

    double getRadioExterno() const;
    double getRadioInterno() const;
    double getAltura() const;
    void setAltura(double altura);


    void setRadios(double radioExterno, double radioInterno);

    double calcularVolumen() override;
    void mostrarDimensiones() const override;
    void mostrarValoresIntermediosVolumen() const override;
};

const double TanqueCilindricoHueco::PI = 3.14159265358979323846;

TanqueCilindricoHueco::TanqueCilindricoHueco() : Tanque()
{
    this->radioExterno = 0.0;
    this->radioInterno = 0.0;
    this->altura = 0.0;
    this->tipo = "CilindricoHueco";
}

TanqueCilindricoHueco::TanqueCilindricoHueco(double radioExterno, double radioInterno, double altura, double costoFijo, double costoPorM3)
    : Tanque("CilindricoHueco", costoFijo, costoPorM3)
{
    this->setRadios(radioExterno, radioInterno);
    this->setAltura(altura);
}

double TanqueCilindricoHueco::getRadioExterno() const
{
    return this->radioExterno;
}

double TanqueCilindricoHueco::getRadioInterno() const
{
    return this->radioInterno;
}

double TanqueCilindricoHueco::getAltura() const
{
    return this->altura;
}

void TanqueCilindricoHueco::setAltura(double altura)
{
    this->validarDimensionPositiva(altura, "altura");
    this->altura = altura;
}

void TanqueCilindricoHueco::setRadios(double radioExterno, double radioInterno)
{
    this->validarDimensionPositiva(radioExterno, "radioExterno");
    this->validarDimensionPositiva(radioInterno, "radioInterno");

    if (radioInterno >= radioExterno)
    {
        throw ExcepcionDimensionesInvalidas("El radio interno debe ser menor que el radio externo.");
    }

    this->radioExterno = radioExterno;
    this->radioInterno = radioInterno;
}

double TanqueCilindricoHueco::calcularVolumen()
{
    this->volumen = TanqueCilindricoHueco::PI * this->altura *
        (std::pow(this->radioExterno, 2) - std::pow(this->radioInterno, 2));
    return this->volumen;
}

void TanqueCilindricoHueco::mostrarDimensiones() const
{
    std::cout << "  Radio externo: " << this->radioExterno << " m" << std::endl;
    std::cout << "  Radio interno: " << this->radioInterno << " m" << std::endl;
    std::cout << "  Altura: " << this->altura << " m" << std::endl;
}

void TanqueCilindricoHueco::mostrarValoresIntermediosVolumen() const
{
    std::cout << "  [DEBUG] Formula: volumen = PI * altura * (radioExterno^2 - radioInterno^2)" << std::endl;
    std::cout << "  [DEBUG] radioExterno = " << this->radioExterno << ", radioInterno = " << this->radioInterno
        << ", altura = " << this->altura << std::endl;
    std::cout << "  [DEBUG] radioExterno^2 = " << std::pow(this->radioExterno, 2) << std::endl;
    std::cout << "  [DEBUG] radioInterno^2 = " << std::pow(this->radioInterno, 2) << std::endl;
    std::cout << "  [DEBUG] (radioExterno^2 - radioInterno^2) = "
        << (std::pow(this->radioExterno, 2) - std::pow(this->radioInterno, 2)) << std::endl;
}

// Factura

class Factura
{
private:
    Cliente cliente;
    std::vector<Tanque*> tanques;
    std::vector<std::string> registroErrores;

public:
    Factura();
    Factura(Cliente cliente);
    ~Factura();

    void setCliente(Cliente cliente);
    Cliente getCliente() const;

    void agregarTanque(Tanque* tanque);
    int getCantidadTanques() const;

    void agregarError(std::string mensajeError);

    double calcularTotal() const;

    void mostrarFactura() const;
    void mostrarRegistroErrores() const;
    void mostrarValoresIntermediosCompletos() const;
};

Factura::Factura()
{
}

Factura::Factura(Cliente cliente)
{
    this->cliente = cliente;
}

Factura::~Factura()
{
    for (size_t i = 0; i < this->tanques.size(); i++)
    {
        delete this->tanques[i];
    }
    this->tanques.clear();
}

void Factura::setCliente(Cliente cliente)
{
    this->cliente = cliente;
}

Cliente Factura::getCliente() const
{
    return this->cliente;
}

void Factura::agregarTanque(Tanque* tanque)
{
    this->tanques.push_back(tanque);
}

int Factura::getCantidadTanques() const
{
    return static_cast<int>(this->tanques.size());
}

void Factura::agregarError(std::string mensajeError)
{
    this->registroErrores.push_back(mensajeError);
}

double Factura::calcularTotal() const
{
    double total = 0.0;
    for (size_t i = 0; i < this->tanques.size(); i++)
    {
        total += this->tanques[i]->getPrecio();
    }
    return total;
}

void Factura::mostrarFactura() const
{
    std::cout << "\n===== FACTURA =====" << std::endl;
    std::cout << "--- Datos del cliente ---" << std::endl;
    this->cliente.mostrarDatos();

    std::cout << "\n--- Tanques adquiridos ---" << std::endl;
    if (this->tanques.empty())
    {
        std::cout << "No se han registrado tanques." << std::endl;
    }

    for (size_t i = 0; i < this->tanques.size(); i++)
    {
        std::cout << "\nTanque #" << (i + 1) << " - Tipo: " << this->tanques[i]->getTipo() << std::endl;
        this->tanques[i]->mostrarDimensiones();
        std::cout << "  Volumen: " << std::fixed << std::setprecision(4) << this->tanques[i]->getVolumen() << " m3" << std::endl;
        std::cout << "  Precio individual: Q" << std::fixed << std::setprecision(2) << this->tanques[i]->getPrecio() << std::endl;
    }

    std::cout << "\nTotal a pagar: Q" << std::fixed << std::setprecision(2) << this->calcularTotal() << std::endl;
    std::cout << "====================\n" << std::endl;
}

void Factura::mostrarRegistroErrores() const
{
    std::cout << "\n===== REGISTRO DE ERRORES =====" << std::endl;
    if (this->registroErrores.empty())
    {
        std::cout << "No se registraron errores durante la ejecucion." << std::endl;
    }
    else
    {
        for (size_t i = 0; i < this->registroErrores.size(); i++)
        {
            std::cout << (i + 1) << ". " << this->registroErrores[i] << std::endl;
        }
    }
    std::cout << "================================\n" << std::endl;
}

void Factura::mostrarValoresIntermediosCompletos() const
{
    std::cout << "\n===== VALORES INTERMEDIOS (DEPURACION) =====" << std::endl;
    if (this->tanques.empty())
    {
        std::cout << "No hay tanques registrados para depurar." << std::endl;
    }

    for (size_t i = 0; i < this->tanques.size(); i++)
    {
        std::cout << "\nTanque #" << (i + 1) << " - Tipo: " << this->tanques[i]->getTipo() << std::endl;
        this->tanques[i]->mostrarValoresIntermediosVolumen();
        std::cout << "  [DEBUG] costoFijo = " << this->tanques[i]->getCostoFijo() << std::endl;
        std::cout << "  [DEBUG] costoPorM3 = " << this->tanques[i]->getCostoPorM3() << std::endl;
        std::cout << "  [DEBUG] precio = costoFijo + (costoPorM3 * volumen) = "
            << this->tanques[i]->getCostoFijo() << " + (" << this->tanques[i]->getCostoPorM3()
            << " * " << this->tanques[i]->getVolumen() << ") = "
            << this->tanques[i]->getPrecio() << std::endl;
    }
    std::cout << "=============================================\n" << std::endl;
}


// Utilidades de lectura validada


double leerDouble(const std::string& mensaje)
{
    double valor;
    while (true)
    {
        std::cout << mensaje;
        std::cin >> valor;

        if (std::cin.fail())
        {
            std::cin.clear();
            std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
            std::cout << "Entrada invalida. Ingrese un numero." << std::endl;
            continue;
        }

        std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
        return valor;
    }
}

int leerEntero(const std::string& mensaje)
{
    int valor;
    while (true)
    {
        std::cout << mensaje;
        std::cin >> valor;

        if (std::cin.fail())
        {
            std::cin.clear();
            std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
            std::cout << "Entrada invalida. Ingrese un numero entero." << std::endl;
            continue;
        }

        std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
        return valor;
    }
}

std::string leerTexto(const std::string& mensaje)
{
    std::string valor;
    std::cout << mensaje;
    std::getline(std::cin, valor);
    return valor;
}


