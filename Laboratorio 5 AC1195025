// Tanque (clase base abstracta)

class Tanque
{
protected:
    std::string tipo;
    double volumen;
    double precio;
    double costoFijo;
    double costoPorM3;

public:
    Tanque();
    Tanque(std::string tipo, double costoFijo, double costoPorM3);
    virtual ~Tanque();

    std::string getTipo() const;
    void setTipo(std::string tipo);

    double getVolumen() const;
    double getPrecio() const;

    double getCostoFijo() const;
    void setCostoFijo(double costoFijo);

    double getCostoPorM3() const;
    void setCostoPorM3(double costoPorM3);

    virtual double calcularVolumen() = 0;

    double calcularPrecio();

    virtual void mostrarDimensiones() const = 0;


    virtual void mostrarValoresIntermediosVolumen() const = 0;

protected:
    void validarDimensionPositiva(double valor, std::string nombreDimension) const;
};

Tanque::Tanque()
{
    this->tipo = "";
    this->volumen = 0.0;
    this->precio = 0.0;
    this->costoFijo = 0.0;
    this->costoPorM3 = 0.0;
}

Tanque::Tanque(std::string tipo, double costoFijo, double costoPorM3)
{
    this->tipo = tipo;
    this->volumen = 0.0;
    this->precio = 0.0;
    this->costoFijo = 0.0;
    this->costoPorM3 = 0.0;

    this->setCostoFijo(costoFijo);
    this->setCostoPorM3(costoPorM3);
}

Tanque::~Tanque()
{
}

std::string Tanque::getTipo() const
{
    return this->tipo;
}

void Tanque::setTipo(std::string tipo)
{
    this->tipo = tipo;
}

double Tanque::getVolumen() const
{
    return this->volumen;
}

double Tanque::getPrecio() const
{
    return this->precio;
}

double Tanque::getCostoFijo() const
{
    return this->costoFijo;
}

void Tanque::setCostoFijo(double costoFijo)
{
    if (costoFijo < 0)
    {
        throw ExcepcionDimensionesInvalidas("El costo fijo no puede ser negativo.");
    }
    this->costoFijo = costoFijo;
}

double Tanque::getCostoPorM3() const
{
    return this->costoPorM3;
}

void Tanque::setCostoPorM3(double costoPorM3)
{
    if (costoPorM3 <= 0)
    {
        throw ExcepcionDimensionesInvalidas("El costo por metro cubico debe ser mayor que cero.");
    }
    this->costoPorM3 = costoPorM3;
}

double Tanque::calcularPrecio()
{
    this->volumen = this->calcularVolumen();

    if (this->volumen <= 0)
    {
        throw ExcepcionDimensionesInvalidas("No se puede calcular el precio: el volumen calculado es invalido.");
    }

    this->precio = this->costoFijo + (this->costoPorM3 * this->volumen);
    return this->precio;
}

void Tanque::validarDimensionPositiva(double valor, std::string nombreDimension) const
{
    if (valor <= 0)
    {
        throw ExcepcionDimensionesInvalidas("La dimension '" + nombreDimension + "' debe ser mayor que cero.");
    }
}

// TanqueCubico

class TanqueCubico : public Tanque
{
private:
    double lado;

public:
    TanqueCubico();
    TanqueCubico(double lado, double costoFijo, double costoPorM3);

    double getLado() const;
    void setLado(double lado);

    double calcularVolumen() override;
    void mostrarDimensiones() const override;
    void mostrarValoresIntermediosVolumen() const override;
};

TanqueCubico::TanqueCubico() : Tanque()
{
    this->lado = 0.0;
    this->tipo = "Cubico";
}

TanqueCubico::TanqueCubico(double lado, double costoFijo, double costoPorM3)
    : Tanque("Cubico", costoFijo, costoPorM3)
{
    this->setLado(lado);
}

double TanqueCubico::getLado() const
{
    return this->lado;
}

void TanqueCubico::setLado(double lado)
{
    this->validarDimensionPositiva(lado, "lado");
    this->lado = lado;
}

double TanqueCubico::calcularVolumen()
{
    this->volumen = std::pow(this->lado, 3);
