Cliente registrarCliente()
{
    std::cout << "\n--- Registro de cliente ---" << std::endl;
    std::string nombre = leerTexto("Nombre: ");
    std::string direccion = leerTexto("Direccion: ");
    std::string telefono = leerTexto("Telefono: ");

    return Cliente(nombre, direccion, telefono);
}


// Creacion de un tanque segun el tipo elegido


Tanque* crearTanque(int tipoSeleccionado)
{
    double costoFijo = leerDouble("Costo fijo (Q): ");
    double costoPorM3 = leerDouble("Costo por metro cubico (Q/m3): ");

    switch (tipoSeleccionado)
    {
    case 1:
    {
        double lado = leerDouble("Lado del cubo (m): ");
        return new TanqueCubico(lado, costoFijo, costoPorM3);
    }
    case 2:
    {
        double radio = leerDouble("Radio de la esfera (m): ");
        return new TanqueEsferico(radio, costoFijo, costoPorM3);
    }
    case 3:
    {
        double radio = leerDouble("Radio del cilindro (m): ");
        double altura = leerDouble("Altura del cilindro (m): ");
        return new TanqueCilindrico(radio, altura, costoFijo, costoPorM3);
    }
    case 4:
    {
        double radioExterno = leerDouble("Radio externo (m): ");
        double radioInterno = leerDouble("Radio interno (m): ");
        double altura = leerDouble("Altura (m): ");
        return new TanqueCilindricoHueco(radioExterno, radioInterno, altura, costoFijo, costoPorM3);
    }
    default:
        return nullptr;
    }
}


// Flujo de compra: agrega uno o varios tanques a la factura

void registrarCompraTanques(Factura& factura)
{
    bool continuarComprando = true;

    while (continuarComprando)
    {
        std::cout << "\n--- Nuevo tanque ---" << std::endl;
        std::cout << "1. Tanque cubico" << std::endl;
        std::cout << "2. Tanque esferico" << std::endl;
        std::cout << "3. Tanque cilindrico" << std::endl;
        std::cout << "4. Tanque cilindrico hueco" << std::endl;
        int tipoSeleccionado = leerEntero("Seleccione el tipo de tanque (1-4): ");

        if (tipoSeleccionado < 1 || tipoSeleccionado > 4)
        {
            std::cout << "Opcion invalida. Intente nuevamente." << std::endl;
            continue;
        }

        Tanque* nuevoTanque = nullptr;

        try
        {
            nuevoTanque = crearTanque(tipoSeleccionado);
            nuevoTanque->calcularPrecio();
            factura.agregarTanque(nuevoTanque);
            std::cout << "Tanque agregado correctamente. Volumen: " << nuevoTanque->getVolumen()
                << " m3 | Precio: Q" << nuevoTanque->getPrecio() << std::endl;
        }
        catch (const ExcepcionDimensionesInvalidas& excepcion)
        {
            std::cout << "Error: " << excepcion.what() << std::endl;
            factura.agregarError(excepcion.what());
            delete nuevoTanque;
        }
        catch (const std::exception& excepcion)
        {
            std::cout << "Error inesperado: " << excepcion.what() << std::endl;
            factura.agregarError(excepcion.what());
            delete nuevoTanque;
        }

        std::string respuesta = leerTexto("\nDesea agregar otro tanque? (s/n): ");
        continuarComprando = (respuesta == "s" || respuesta == "S");
    }
}

// Menu principal

void mostrarMenu()
{
    std::cout << "\n===== SISTEMA DE VENTA DE TANQUES =====" << std::endl;
    std::cout << "1. Registrar cliente y compra" << std::endl;
    std::cout << "2. Mostrar factura" << std::endl;
    std::cout << "3. Mostrar valores intermedios (depuracion)" << std::endl;
    std::cout << "4. Mostrar registro de errores" << std::endl;
    std::cout << "5. Salir" << std::endl;
}

int main()
{
    Factura factura;
    bool clienteRegistrado = false;
    bool salir = false;

    std::cout << "Bienvenido al sistema de fabricacion y venta de tanques de agua." << std::endl;

    while (!salir)
    {
        mostrarMenu();
        int opcion = leerEntero("Seleccione una opcion: ");

        switch (opcion)
        {
        case 1:
        {
            Cliente cliente = registrarCliente();
            factura.setCliente(cliente);
            clienteRegistrado = true;
            registrarCompraTanques(factura);
            break;
        }
        case 2:
            if (!clienteRegistrado)
            {
                std::cout << "\nAun no se ha registrado ningun cliente." << std::endl;
            }
            else
            {
                factura.mostrarFactura();
            }
            break;
        case 3:
            factura.mostrarValoresIntermediosCompletos();
            break;
        case 4:
            factura.mostrarRegistroErrores();
            break;
        case 5:
            salir = true;
            std::cout << "\nGracias por usar el sistema." << std::endl;
            break;
        default:
            std::cout << "Opcion invalida. Intente nuevamente." << std::endl;
            break;
        }
    }

    return 0;
}
